---
import BrandHeader from './BrandHeader.astro';
import Logo from './Logo.astro';
import KuroaxeMark from '../../kuroaxe/components/Mark.astro';
import { serviceGroups, getServicesByGroup, services } from '../../data/services';
import { industries } from '../../data/industries';
import { engineeringPractices, technologyCatalogue } from '../../data/catalogue';
import { primaryNav } from '../../data/navigation';
import { findTechnology } from '../../data/technologies';
import { site } from '../../data/site';
import { withBase } from '../../lib/seo';
import type { HeaderNavItem, HeaderSearchEntry } from './header-types';

const technologyLinks = technologyCatalogue.map((category) => ({ label: category.name, href: withBase(`/about/technologies#${category.id}`) }));
const nav: HeaderNavItem[] = [
  {
    id: 'services', label: 'Services', href: withBase('/services'),
    groups: serviceGroups.map((group) => ({
      id: group.id, label: group.name, description: group.summary,
      href: withBase(`/services#${group.id}`),
      links: getServicesByGroup(group.id).map((service) => ({ label: service.name, href: withBase(`/services/${service.slug}`) })),
    })),
  },
  {
    id: 'industries', label: 'Industries', href: withBase('/about/industries'),
    groups: [
      { id: 'industries', label: 'Industries', description: 'Enterprise engineering shaped around your operating environment.', href: withBase('/about/industries'), links: industries.map((industry) => ({ label: industry.name, href: withBase(`/about/industries#${industry.slug}`) })) },
      { id: 'practices', label: 'Engineering practices', description: 'Connected expertise that supports delivery across industries.', href: withBase('/about/industries#cross-industry-practices'), links: engineeringPractices.map((label) => ({ label, href: withBase('/about/industries#cross-industry-practices') })) },
      { id: 'technology', label: 'Technology ecosystem', description: 'The languages, tools, and platforms behind our engineering work.', href: withBase('/about/technologies'), links: technologyLinks },
    ],
  },
  {
    id: 'about', label: 'About', href: withBase('/about'),
    groups: [{
      id: 'company', label: 'Our company', description: 'Meet Codeaxes, explore our work, and hear from the teams we work with.', href: withBase('/about'),
      links: [{ label: 'About Codeaxes', href: withBase('/about') }, ...(primaryNav.find((item) => item.label === 'About')?.children ?? []).map((item) => ({ label: item.label, href: withBase(item.href) }))],
    }],
  },
  { id: 'careers', label: 'Careers', href: withBase('/careers') },
];
const searchEntries: HeaderSearchEntry[] = [
  ...nav.map((item) => ({ label: item.label, href: item.href, category: 'Explore Codeaxes' })),
  { label: 'Contact Codeaxes', href: withBase('/contact'), category: 'Start a conversation' },
  ...services.map((service) => ({ label: service.name, href: withBase(`/services/${service.slug}`), category: 'Services', keywords: service.stack.join(' ') })),
  ...industries.map((industry) => ({ label: industry.name, href: withBase(`/about/industries#${industry.slug}`), category: 'Industries', keywords: industry.solutions.join(' ') })),
  ...technologyCatalogue.flatMap((category) => category.sections.flatMap((section) => section.items.map((label) => {
    const tech = findTechnology(label);
    return { label, href: withBase(tech ? `/about/technologies/${tech.slug}` : `/about/technologies#${category.id}`), category: category.name };
  }))),
  ...nav.flatMap((item) => item.groups?.flatMap((group) => group.links.map((link) => ({ ...link, category: group.label }))) ?? []),
];
---

<BrandHeader brand="codeaxes" name="Codeaxes" nav={nav} contactHref={withBase('/contact')} partner={{ name: 'Kuroaxe', href: site.kuroaxe.url }} searchEntries={searchEntries} searchPlaceholder="Search services, industries, technologies…">
  <Logo slot="logo" />
  <KuroaxeMark slot="partner-mark" />
</BrandHeader>
