---
import { withBase } from '../../lib/seo';

type Props = {
  class?: string;
  compact?: boolean;
};

const { compact = false } = Astro.props;
---

<a href={withBase('/')} class:list={['group inline-flex items-center gap-3', Astro.props.class]} aria-label="Codeaxes home">
  <img src={withBase('/favicon.svg')} width="36" height="32" alt="" class="brand-mark h-8 w-auto" />
  {
    !compact && (
      <span class="leading-none">
        <span class="font-display block text-[1.05rem] font-medium tracking-tight text-paper">[Codeaxes]</span>
        <span class="hidden text-[11px] font-medium tracking-normal text-mist sm:block">Product engineering</span>
      </span>
    )
  }
</a>
