---
import { footerNav } from '../../data/navigation';
import { site } from '../../data/site';
import { withBase } from '../../lib/seo';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-top">
    <div class="footer-lead">
      <h2>
        Engineering
        <span>ambitious products.</span>
      </h2>
      <p>Share the constraint. We’ll come back with a discovery plan.</p>
      <form data-newsletter>
        <label class="sr-only" for="newsletter-email">Work email for product notes</label>
        <input class="sr-only" tabindex="-1" autocomplete="off" name="company_url" aria-hidden="true" />
        <input
          id="newsletter-email"
          name="email"
          type="email"
          required
          placeholder="Work email"
          autocomplete="email"
        />
        <button type="submit">Notes</button>
      </form>
      <p data-newsletter-status aria-live="polite"></p>
    </div>

    <nav aria-label="Footer">
      {
        footerNav.map((link) => (
          <a href={withBase(link.href)}>{link.label}</a>
        ))
      }
      <a href={site.kuroaxe.url}>{site.kuroaxe.name}</a>
    </nav>

    <address>
      <p>
        {site.address.line1}<br />
        {site.address.city}, {site.address.region} {site.address.postal}
      </p>
      <p>
        <a href={`mailto:${site.email}`}>{site.email}</a><br />
        <a href={`tel:${site.phone.replace(/[^\d+]/g, '')}`}>{site.phone}</a>
      </p>
      <p class="footer-social">
        {
          Object.entries(site.social).map(([name, href]) => (
            <a href={href} target="_blank" rel="noopener noreferrer">
              {name}
            </a>
          ))
        }
      </p>
    </address>
  </div>

  <p class="footer-legal">
    <span>© {year} {site.legalName}. All rights reserved.</span>
    <span>
      <a href={site.kuroaxe.url}>{site.kuroaxe.name}</a>
      . {site.kuroaxe.label}
    </span>
  </p>

  <div class="footer-word" aria-hidden="true">
    <p>CODEAXES</p>
  </div>
</footer>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-newsletter]');
  const status = document.querySelector('[data-newsletter-status]');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const email = String(new FormData(form).get('email') ?? '').trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      status && (status.textContent = 'Enter a valid work email.');
      return;
    }
    status && (status.textContent = 'Saving…');
    try {
      const response = await fetch(`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}api/newsletter`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form).entries())),
      });
      const payload = (await response.json().catch(() => ({}))) as { error?: string };
      if (!response.ok) {
        status && (status.textContent = payload.error || 'Could not save that email.');
        return;
      }
      form.reset();
      status && (status.textContent = 'Saved. We will send product notes to that address.');
    } catch {
      status && (status.textContent = 'The notes form is unavailable right now.');
    }
  });
</script>

<style>
  .site-footer {
    overflow: hidden;
    background: #f7f9fc;
    color: var(--paper);
  }

  .footer-top {
    display: grid;
    gap: 2.5rem;
    max-width: 76rem;
    margin: 0 auto;
    padding: 4.5rem 1.25rem 0;
  }

  .footer-lead h2 {
    margin: 0;
    max-width: 11ch;
    color: var(--paper);
    font-size: clamp(2.7rem, 6.4vw, 5.4rem);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .footer-lead h2 span {
    display: block;
    background: linear-gradient(100deg, #2f62a8 0%, #3d944c 100%);
    background-clip: text;
    color: transparent;
  }

  .footer-lead > p {
    max-width: 28rem;
    margin: 1.25rem 0 0;
    color: var(--mist);
    font-size: 1rem;
    line-height: 1.5;
  }

  .footer-lead form {
    display: flex;
    gap: 0.5rem;
    max-width: 24rem;
    margin-top: 1.4rem;
  }

  .footer-lead input[type='email'] {
    min-width: 0;
    min-height: 2.75rem;
    flex: 1;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #ffffff;
    padding: 0.4rem 1rem;
    color: var(--paper);
    font-size: 1rem;
  }

  .footer-lead button {
    min-height: 2.75rem;
    cursor: pointer;
    border: 0;
    border-radius: 999px;
    background: #12141c;
    padding: 0.4rem 1rem;
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .footer-lead [data-newsletter-status] {
    min-height: 1.25rem;
    margin: 0.55rem 0 0;
    color: var(--mist);
    font-size: 0.85rem;
  }

  .site-footer nav,
  .site-footer address {
    display: grid;
    align-content: start;
    gap: 0.7rem;
    font-style: normal;
  }

  .site-footer nav a,
  .site-footer address a,
  .site-footer address p {
    color: var(--mist);
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .site-footer nav a:hover,
  .site-footer address a:hover {
    color: var(--paper);
  }

  .footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    margin-top: 0.4rem;
    text-transform: capitalize;
  }

  .footer-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    justify-content: space-between;
    max-width: 76rem;
    margin: 3rem auto 0;
    padding: 0 1.25rem;
    color: var(--mist);
    font-size: 0.78rem;
  }

  .footer-legal a {
    color: var(--paper);
  }

  .footer-word {
    height: calc(0.46 * clamp(5.4rem, 20.5vw, 22rem));
    margin-top: 1.5rem;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
  }

  .footer-word p {
    margin: 0;
    color: transparent;
    font-family: var(--font-display);
    font-size: clamp(5.4rem, 20.5vw, 22rem);
    font-weight: 700;
    letter-spacing: -0.07em;
    line-height: 0.78;
    text-align: center;
    white-space: nowrap;
    -webkit-text-stroke: clamp(1px, 0.14vw, 2px) rgb(18 20 28 / 72%);
  }

  @media (min-width: 900px) {
    .footer-top {
      grid-template-columns: minmax(0, 1.5fr) auto auto;
      align-items: start;
      gap: 4rem;
      padding: 5.5rem 2rem 0;
    }

    .footer-legal {
      padding: 0 2rem;
    }
  }

  @media (max-width: 767px) {
    .site-footer {
      padding-bottom: 0;
    }

    .footer-top {
      padding-bottom: calc(4.75rem + env(safe-area-inset-bottom));
    }

    .footer-legal {
      margin-top: 0;
    }
  }
</style>
