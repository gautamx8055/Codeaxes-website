---
import Logo from './Logo.astro';
import Button from '../ui/Button.astro';
import { footerNav } from '../../data/navigation';
import { site } from '../../data/site';
import { withBase } from '../../lib/seo';

const year = new Date().getFullYear();
const location = `${site.address.city}, ${site.address.region}`;
---

<footer class="border-t border-line">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 py-10 sm:px-5 md:px-8 lg:py-12">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-sm">
        <Logo />
        <p class="mt-4 text-sm leading-relaxed text-mist">{site.tagline}</p>
        <p class="mt-3 text-sm text-mist">
          <a class="hover:text-paper" href={`mailto:${site.email}`}>{site.email}</a>
          <span class="mx-2 text-line" aria-hidden="true">·</span>
          <a class="hover:text-paper" href={`tel:${site.phone.replace(/[^\d+]/g, '')}`}>{site.phone}</a>
        </p>
        <p class="mt-1 text-sm text-mist">{location}</p>
      </div>
      <Button href={site.cta.primary.href}>{site.cta.primary.label}</Button>
    </div>

    <nav aria-label="Footer" class="flex flex-wrap gap-x-6 gap-y-2 border-y border-line py-4">
      {
        footerNav.map((link) => (
          <a href={withBase(link.href)} class="text-sm font-medium text-mist transition-colors duration-300 hover:text-paper">
            {link.label}
          </a>
        ))
      }
      <a
        href={site.kuroaxe.url}
        class="text-sm font-medium text-mist transition-colors duration-300 hover:text-paper"
        target="_blank"
        rel="noopener noreferrer"
      >
        {site.kuroaxe.name} ↗
      </a>
    </nav>

    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div class="w-full min-w-0 max-w-md">
        <form class="flex w-full min-w-0 gap-2" data-newsletter>
          <label class="sr-only" for="newsletter-email">Work email for product notes</label>
          <input class="sr-only" tabindex="-1" autocomplete="off" name="company_url" aria-hidden="true" />
          <input
            id="newsletter-email"
            name="email"
            type="email"
            required
            placeholder="Work email"
            class="min-h-11 min-w-0 w-full rounded-xl border border-line bg-ink px-4 py-2 text-base text-paper placeholder:text-mist"
          />
          <button type="submit" class="btn-sheen min-h-11 shrink-0 cursor-pointer rounded-xl px-4 py-2 text-[15px] font-medium text-white">
            Notes
          </button>
        </form>
        <p class="mt-2 text-sm text-mist" data-newsletter-status aria-live="polite"></p>
      </div>
      <div class="flex flex-wrap gap-4 text-sm text-mist">
        {
          Object.entries(site.social).map(([name, href]) => (
            <a href={href} class="capitalize hover:text-paper" target="_blank" rel="noopener noreferrer">
              {name}
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <div class="border-t border-line">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-5 text-xs text-mist sm:px-5 md:flex-row md:items-center md:justify-between md:px-8">
      <p>© {year} {site.legalName}. All rights reserved.</p>
      <p>
        <a href={site.kuroaxe.url} class="text-paper hover:text-pulse" target="_blank" rel="noopener noreferrer">
          {site.kuroaxe.name}
        </a>
        <span>. {site.kuroaxe.label}</span>
      </p>
    </div>
  </div>
</footer>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-newsletter]');
  const status = document.querySelector('[data-newsletter-status]');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const email = String(new FormData(form).get('email') ?? '').trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      status && (status.textContent = 'Enter a valid work email.');
      return;
    }
    status && (status.textContent = 'Saving…');
    try {
      const response = await fetch(`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}api/newsletter`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form).entries())),
      });
      const payload = (await response.json().catch(() => ({}))) as { error?: string };
      if (!response.ok) {
        status && (status.textContent = payload.error || 'Could not save that email.');
        return;
      }
      form.reset();
      status && (status.textContent = 'Saved. We will send product notes to that address.');
    } catch {
      status && (status.textContent = 'The notes form is unavailable right now.');
    }
  });
</script>
