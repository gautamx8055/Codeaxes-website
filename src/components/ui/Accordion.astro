---
type Props = {
  items: { question: string; answer: string }[];
  name?: string;
};

const { items, name = 'faq' } = Astro.props;
---

<div class="divide-y divide-line border-y border-line">
  {
    items.map((item, index) => (
      <details class="group" name={name} open={index === 0 ? undefined : undefined}>
        <summary class="cursor-pointer list-none px-0 py-5 font-display text-lg text-paper marker:content-none focus-visible:outline-pulse [&::-webkit-details-marker]:hidden">
          <span class="flex items-start justify-between gap-6">
            <span>{item.question}</span>
            <span class="font-mono mt-1 text-pulse transition group-open:rotate-45" aria-hidden="true">
              +
            </span>
          </span>
        </summary>
        <p class="max-w-3xl pb-6 text-mist">{item.answer}</p>
      </details>
    ))
  }
</div>
