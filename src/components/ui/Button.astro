---
import { withBase } from '../../lib/seo';

type Variant = 'primary' | 'secondary' | 'ghost';

type Props = {
  href?: string;
  variant?: Variant;
  class?: string;
  type?: 'button' | 'submit';
  external?: boolean;
};

const { href, variant = 'primary', type = 'button', external = false } = Astro.props;
const resolvedHref = href ? withBase(href) : undefined;

const classes = {
  primary: 'bg-paper text-void hover:opacity-90',
  secondary: 'border border-line bg-ink text-paper hover:border-axis hover:text-axis',
  ghost: 'text-paper hover:text-axis',
}[variant];

const shared =
  'inline-flex cursor-pointer items-center justify-center gap-2 rounded-full px-6 py-2.5 text-[13px] font-semibold tracking-[0.04em] transition-all duration-300 ease-out';
---

{
  resolvedHref ? (
    <a
      href={resolvedHref}
      class:list={[shared, classes, Astro.props.class]}
      {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
    >
      <slot />
    </a>
  ) : (
    <button type={type} class:list={[shared, classes, Astro.props.class]}>
      <slot />
    </button>
  )
}
