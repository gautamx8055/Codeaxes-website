---
import { withBase } from '../../lib/seo';

type Variant = 'primary' | 'secondary' | 'ghost';

type Props = {
  href?: string;
  variant?: Variant;
  class?: string;
  type?: 'button' | 'submit';
  external?: boolean;
};

const { href, variant = 'primary', type = 'button', external = false } = Astro.props;
const resolvedHref = href ? withBase(href) : undefined;

const classes = {
  primary: 'btn-sheen text-white',
  secondary: 'btn-outline border border-line bg-transparent text-paper',
  ghost: 'text-paper hover:text-mist',
}[variant];

const shared =
  'inline-flex min-h-11 cursor-pointer items-center justify-center gap-2 rounded-xl px-5 py-2 text-[15px] font-medium tracking-normal transition-colors duration-300 ease-out sm:px-6';
---

{
  resolvedHref ? (
    <a
      href={resolvedHref}
      class:list={[shared, classes, Astro.props.class]}
      {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
    >
      <span class="relative z-10"><slot /></span>
    </a>
  ) : (
    <button type={type} class:list={[shared, classes, Astro.props.class]}>
      <span class="relative z-10"><slot /></span>
    </button>
  )
}
