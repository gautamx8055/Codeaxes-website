---
import type { CaseStudy } from '../../types';
import ServiceVisual from '../visuals/ServiceVisual.astro';
import { withBase } from '../../lib/seo';

type Props = {
  study: CaseStudy;
};

const { study } = Astro.props;
const visual =
  study.visual === 'dashboard'
    ? 'dashboard'
    : study.visual === 'devices'
      ? 'devices'
      : study.visual === 'architecture'
        ? 'architecture'
        : 'workflow';

const tone =
  visual === 'devices' || visual === 'workflow' ? 'signal' : 'axis';
const outcome = study.outcomes[0];
---

<a
  href={withBase(`/about/case-studies/${study.slug}`)}
  class:list={['study-card group', tone === 'signal' && 'is-signal']}
  data-industry={study.industry}
  data-services={study.services.join(',')}
>
  <div class="study-card-preview" aria-hidden="true">
    <ServiceVisual kind={visual} />
  </div>
  <div class="study-card-body">
    <p class="study-card-industry">{study.industry}</p>
    <h3>{study.client}</h3>
    <p class="study-card-summary">{study.summary}</p>
    <ul class="study-card-stack">
      {study.stack.slice(0, 3).map((item) => <li>{item}</li>)}
    </ul>
    {outcome && (
      <p class="study-card-outcome">
        <span>{outcome.label}</span>
        {outcome.value}
      </p>
    )}
    <p class="study-card-open">Open study</p>
  </div>
</a>

<style>
  .study-card {
    display: flex;
    height: 100%;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 1.35rem;
    background: var(--color-ink);
    color: inherit;
    text-decoration: none;
    box-shadow: inset 0 3px 0 var(--color-axis);
    transition:
      border-color 0.28s ease,
      box-shadow 0.28s ease,
      transform 0.28s ease;
  }

  .study-card.is-signal {
    box-shadow: inset 0 3px 0 var(--color-signal);
  }

  .study-card:hover,
  .study-card:focus-visible {
    border-color: color-mix(in oklab, var(--color-axis) 55%, var(--color-line));
    box-shadow:
      inset 0 3px 0 var(--color-axis),
      0 18px 34px rgb(18 20 28 / 10%);
    transform: translateY(-6px);
    outline: none;
  }

  .study-card.is-signal:hover,
  .study-card.is-signal:focus-visible {
    border-color: color-mix(in oklab, var(--color-signal) 55%, var(--color-line));
    box-shadow:
      inset 0 3px 0 var(--color-signal),
      0 18px 34px rgb(18 20 28 / 10%);
  }

  .study-card-preview {
    max-height: 9.5rem;
    overflow: hidden;
    border-bottom: 1px solid var(--color-line);
    background:
      radial-gradient(ellipse 80% 80% at 100% 0%, color-mix(in oklab, var(--color-axis) 16%, transparent), transparent 70%),
      var(--color-slate);
  }

  .study-card-preview :global(> div) {
    transition: transform 0.45s ease;
  }

  .study-card:hover .study-card-preview :global(> div),
  .study-card:focus-visible .study-card-preview :global(> div) {
    transform: scale(1.06);
  }

  .study-card.is-signal .study-card-preview {
    background:
      radial-gradient(ellipse 80% 80% at 0% 0%, color-mix(in oklab, var(--color-signal) 18%, transparent), transparent 70%),
      var(--color-slate);
  }

  .study-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 1.15rem 1.2rem 1.2rem;
  }

  .study-card-industry {
    margin: 0;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-axis);
  }

  .study-card.is-signal .study-card-industry,
  .study-card.is-signal .study-card-open {
    color: var(--color-signal);
  }

  .study-card h3 {
    margin: 0.45rem 0 0;
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.03em;
    color: var(--color-paper);
  }

  .study-card-summary {
    margin: 0.65rem 0 0;
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--color-mist);
  }

  .study-card-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
  }

  .study-card-stack li {
    border-radius: 999px;
    background: var(--color-slate);
    padding: 0.2rem 0.55rem;
    font-size: 0.72rem;
    color: var(--color-mist);
  }

  .study-card-outcome {
    margin: 1rem 0 0;
    border-radius: 0.9rem;
    background: color-mix(in oklab, var(--color-axis) 8%, var(--color-slate));
    padding: 0.7rem 0.8rem;
    font-size: 0.88rem;
    line-height: 1.4;
    color: var(--color-paper);
  }

  .study-card.is-signal .study-card-outcome {
    background: color-mix(in oklab, var(--color-signal) 10%, var(--color-slate));
  }

  .study-card-outcome span {
    display: block;
    margin-bottom: 0.15rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-mist);
  }

  .study-card-open {
    margin: auto 0 0;
    padding-top: 1rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-axis);
  }

  .study-card-open::after {
    content: '→';
    display: inline-block;
    margin-left: 0.4rem;
    transition: transform 0.28s ease;
  }

  .study-card:hover .study-card-open::after,
  .study-card:focus-visible .study-card-open::after {
    transform: translateX(5px);
  }

  @media (prefers-reduced-motion: reduce) {
    .study-card,
    .study-card-preview :global(> div),
    .study-card-open::after {
      transition: none;
    }

    .study-card:hover,
    .study-card:focus-visible,
    .study-card:hover .study-card-preview :global(> div),
    .study-card:focus-visible .study-card-preview :global(> div),
    .study-card:hover .study-card-open::after,
    .study-card:focus-visible .study-card-open::after {
      transform: none;
    }
  }
</style>
