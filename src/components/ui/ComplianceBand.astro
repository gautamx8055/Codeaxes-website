---
const groups = [
  {
    title: 'Data privacy and protection',
    chips: ['GDPR', 'CCPA', 'HIPAA'],
  },
  {
    title: 'Security and risk management',
    chips: ['SOC 2', 'ISO 27001', 'NIST'],
  },
  {
    title: 'AI and technology rules',
    chips: ['EU AI Act', 'Model logging', 'Access control'],
  },
  {
    title: 'Industry standards',
    chips: ['HIPAA', 'PCI scope', 'FHIR'],
  },
  {
    title: 'Global frameworks',
    chips: ['Data residency', 'SCCs', 'DPA'],
  },
  {
    title: 'Cloud and SaaS controls',
    chips: ['Encryption', 'IAM', 'Audit logs'],
  },
];
---

<section class="compliance-band" aria-labelledby="compliance-title">
  <div class="compliance-band-inner">
    <div class="compliance-lead">
      <svg class="compliance-shield" viewBox="0 0 160 160" aria-hidden="true">
        <defs>
          <radialGradient id="compliance-shield-glow" cx="35%" cy="30%" r="70%">
            <stop offset="0%" stop-color="#d7ebff" />
            <stop offset="55%" stop-color="#4c8dff" />
            <stop offset="100%" stop-color="#1d4ed8" />
          </radialGradient>
        </defs>
        <path
          fill="url(#compliance-shield-glow)"
          d="M80 12 138 36v42c0 36-24 62-58 74-34-12-58-38-58-74V36L80 12z"
        />
        <path
          fill="none"
          stroke="#ffffff"
          stroke-opacity="0.45"
          stroke-width="2"
          d="M80 28 124 46v30c0 28-18 48-44 58-26-10-44-30-44-58V46L80 28z"
        />
        <path
          fill="none"
          stroke="#ffffff"
          stroke-width="3.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M58 82 74 98 106 62"
        />
      </svg>
      <h2 id="compliance-title">Building with compliance and risk in mind</h2>
      <p>
        Codeaxes treats controls as part of the product. Access, encryption, and audit trails are designed with the workflow, so regulated teams can review the system without a scavenger hunt.
      </p>
    </div>

    <div class="compliance-list">
      {
        groups.map((group, index) => (
          <details class="compliance-item" name="compliance" open={index === 0}>
            <summary>
              <span class="compliance-index">[{index + 1}]</span>
              <span class="compliance-name">{group.title}</span>
              <span class="compliance-chevron" aria-hidden="true" />
            </summary>
            <ul>
              {group.chips.map((chip) => (
                <li>
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path fill="currentColor" d="M8 1.2 13.2 3.4v4.2c0 3.2-2.1 5.5-5.2 6.6C4.9 13.1 2.8 10.8 2.8 7.6V3.4L8 1.2z" />
                  </svg>
                  {chip}
                </li>
              ))}
            </ul>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .compliance-band {
    background: linear-gradient(115deg, #1d4ed8 0%, #3b82f6 48%, #60a5fa 100%);
    color: #ffffff;
  }

  .compliance-band-inner {
    display: grid;
    gap: 2.5rem;
    margin: 0 auto;
    max-width: 72rem;
    padding: 3.5rem 1.25rem;
  }

  .compliance-shield {
    width: 7.5rem;
    height: 7.5rem;
    filter: drop-shadow(0 18px 24px rgb(15 23 42 / 22%));
  }

  .compliance-lead h2 {
    margin: 1.5rem 0 0;
    max-width: 16ch;
    color: #ffffff;
    font-size: clamp(2rem, 4vw, 3.1rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.25;
  }

  .compliance-lead p {
    margin: 1rem 0 0;
    max-width: 36rem;
    color: rgb(255 255 255 / 88%);
    font-size: 1rem;
    line-height: 1.6;
  }

  .compliance-list {
    align-self: center;
  }

  .compliance-item {
    border-bottom: 1px solid rgb(255 255 255 / 28%);
  }

  .compliance-item summary {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.85rem;
    min-height: 3.4rem;
    cursor: pointer;
    list-style: none;
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 600;
  }

  .compliance-item summary::-webkit-details-marker {
    display: none;
  }

  .compliance-index {
    color: rgb(255 255 255 / 72%);
    font-weight: 500;
  }

  .compliance-chevron {
    width: 0.55rem;
    height: 0.55rem;
    border-right: 2px solid #ffffff;
    border-bottom: 2px solid #ffffff;
    transform: rotate(45deg);
    transition: transform 0.2s ease;
  }

  .compliance-item[open] .compliance-chevron {
    transform: rotate(225deg);
  }

  .compliance-item ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0;
    padding: 0 0 1rem 2.2rem;
    list-style: none;
  }

  .compliance-item li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border-radius: 999px;
    background: #ffffff;
    color: #1d4ed8;
    padding: 0.45rem 0.8rem;
    font-size: 0.92rem;
    font-weight: 600;
  }

  .compliance-item li svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  @media (min-width: 960px) {
    .compliance-band-inner {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      align-items: center;
      gap: 4rem;
      padding: 4.5rem 2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .compliance-chevron {
      transition: none;
    }
  }
</style>
