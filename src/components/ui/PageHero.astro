---
type Props = {
  eyebrow: string;
  title: string;
  body?: string;
  layout?: 'split' | 'center' | 'rail';
};

const { eyebrow, title, body, layout = 'split' } = Astro.props;
const hasVisual = Astro.slots.has('default');
---

<header class="relative overflow-hidden text-center" data-hero>
  <div class="hero-enter relative mx-auto flex min-h-[min(28rem,70svh)] max-w-4xl flex-col items-center justify-center px-4 py-16 sm:px-5 md:px-8 md:py-24">
    <p class="kicker mb-5">{eyebrow}</p>
    <h1 class="headline-beam font-display text-[2.6rem] font-medium leading-[0.92] tracking-[-0.05em] sm:text-5xl md:text-7xl">{title}</h1>
    {body && <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-mist sm:text-lg">{body}</p>}
    {
      Astro.slots.has('actions') && (
        <div class="mt-7 flex w-full flex-col items-stretch gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:justify-center">
          <slot name="actions" />
        </div>
      )
    }
    {
      Astro.slots.has('panel') && (
        <div class="mt-8 w-full max-w-xl">
          <slot name="panel" />
        </div>
      )
    }
    {
      hasVisual && layout !== 'rail' && (
        <div class="tech-frame mx-auto mt-8 w-full max-w-xl">
          <slot />
        </div>
      )
    }
  </div>
</header>
