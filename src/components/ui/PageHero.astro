---
type Props = {
  eyebrow: string;
  title: string;
  body?: string;
  layout?: 'split' | 'center' | 'rail';
};

const { eyebrow, title, body, layout = 'split' } = Astro.props;
const hasVisual = Astro.slots.has('default');
---

<header class="relative overflow-hidden border-b border-line text-center" data-hero>
  <div class="pointer-events-none absolute inset-0 opacity-40 grid-axes"></div>
  <div class="relative mx-auto flex max-w-4xl flex-col items-center px-4 pt-6 pb-10 sm:px-5 sm:pt-8 sm:pb-12 md:px-8 md:pt-10 md:pb-14">
    <p class="kicker mb-4">{eyebrow}</p>
    <h1 class="headline-beam font-display text-[2.2rem] leading-[0.96] sm:text-4xl md:text-6xl">{title}</h1>
    {body && <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-mist sm:text-lg">{body}</p>}
    {
      Astro.slots.has('actions') && (
        <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
          <slot name="actions" />
        </div>
      )
    }
    {
      hasVisual && layout !== 'rail' && (
        <div class="tech-frame mx-auto mt-8 w-full max-w-xl">
          <slot />
        </div>
      )
    }
  </div>
</header>
