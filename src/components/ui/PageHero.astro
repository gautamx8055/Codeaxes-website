---
type Props = {
  eyebrow: string;
  title: string;
  body?: string;
  layout?: 'split' | 'center' | 'rail';
};

const { eyebrow, title, body, layout = 'split' } = Astro.props;
---

<header
  class:list={[
    'relative overflow-hidden border-b border-line',
    layout === 'center' && 'text-center',
  ]}
>
  <div class="pointer-events-none absolute inset-0 opacity-40 grid-axes"></div>
  <div
    class:list={[
      'relative mx-auto max-w-6xl px-5 py-20 md:px-8 md:py-28',
      layout === 'split' && 'grid gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.9fr)] lg:items-end',
      layout === 'rail' && 'max-w-3xl',
    ]}
  >
    <div>
      <p class="mb-4 flex items-center gap-3 text-sm font-semibold tracking-[0.08em] text-axis">
        {eyebrow}
      </p>
      <h1 class="headline-beam font-display text-4xl leading-[1.15] md:text-6xl">{title}</h1>
      {body && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-mist">{body}</p>}
      <div class="mt-8 flex flex-wrap gap-3">
        <slot name="actions" />
      </div>
    </div>
    {
      layout !== 'rail' && (
        <div class:list={['tech-frame', layout === 'center' && 'mx-auto w-full max-w-xl']}>
          <slot />
        </div>
      )
    }
  </div>
</header>
