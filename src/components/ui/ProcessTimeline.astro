---
import { deliveryProcess } from '../../data/process';

const glyphs = [
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4 8v8l8 5 8-5V8l-8-5z"/><path d="M12 12 4 8"/><path d="m12 12 8-4"/><path d="M12 12v9"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 17h7M17.5 14v7"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h16"/><path d="M8 20V9l4-3 4 3v11"/><path d="M10 13h4"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 11 4 16l5 5"/><path d="M4 16h10a6 6 0 0 0 0-12H9"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 19h14"/><path d="M7 19 12 5l5 14"/><path d="M9.2 13h5.6"/></svg>',
  '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 14a8 8 0 1 0 7.1-7.95"/><path d="M12 8v4l3 2"/></svg>',
];
---

<div class="process-board">
  <ol class="process-track" aria-hidden="true">
    {
      deliveryProcess.map((step, index) => (
        <li>
          <span>{String(index + 1).padStart(2, '0')}</span>
          {step.title}
        </li>
      ))
    }
  </ol>

  <ol class="process-spine" data-reveal-stagger aria-label="Delivery process">
    {
      deliveryProcess.map((step, index) => {
        const next = deliveryProcess[index + 1];
        return (
          <li class="process-station">
            <div class="process-node">
              <span>{String(index + 1).padStart(2, '0')}</span>
            </div>
            <article class="process-card">
              <div class="process-card-head">
                <span class="process-glyph" set:html={glyphs[index]} />
                <p class="process-step">Step {String(index + 1).padStart(2, '0')} of {String(deliveryProcess.length).padStart(2, '0')}</p>
              </div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
              {next ? (
                <p class="process-next">
                  Next <span>{next.title}</span>
                </p>
              ) : (
                <p class="process-next is-last">Sequence complete</p>
              )}
            </article>
          </li>
        );
      })
    }
  </ol>
</div>

<style>
  .process-board {
    position: relative;
  }

  .process-track {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    padding-bottom: 1.15rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-line);
  }

  .process-track li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex: 0 0 auto;
    padding: 0.45rem 0.8rem 0.45rem 0.45rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-ink) 88%, transparent);
    font-family: var(--font-display);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-paper);
  }

  .process-track li span {
    display: grid;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-axis) 16%, transparent);
    color: var(--color-axis);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
  }

  .process-track li:nth-child(2) span,
  .process-track li:nth-child(5) span { color: var(--color-signal); background: color-mix(in oklab, var(--color-signal) 16%, transparent); }
  .process-track li:nth-child(3) span,
  .process-track li:nth-child(6) span { color: var(--color-pulse); background: color-mix(in oklab, var(--color-pulse) 16%, transparent); }

  .process-spine {
    position: relative;
    display: grid;
    gap: 1.15rem;
  }

  .process-spine::before {
    content: '';
    position: absolute;
    left: 1.55rem;
    top: 1.7rem;
    bottom: 1.7rem;
    width: 2px;
    background: linear-gradient(180deg, var(--color-axis), var(--color-signal), var(--color-pulse));
    opacity: 0.9;
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 1.1s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .process-spine.is-inview::before {
    transform: scaleY(1);
  }

  .process-station {
    position: relative;
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .process-node {
    position: relative;
    z-index: 1;
    display: grid;
    width: 3.1rem;
    height: 3.1rem;
    place-items: center;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--color-axis) 50%, var(--color-line));
    background: var(--color-ink);
    box-shadow: 0 0 0 6px var(--color-void), 0 0 22px color-mix(in oklab, var(--color-axis) 22%, transparent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-axis);
  }

  .process-card {
    border: 1px solid var(--color-line);
    border-radius: 1.2rem;
    background:
      linear-gradient(180deg, color-mix(in oklab, var(--color-axis) 8%, transparent), transparent 38%),
      color-mix(in oklab, var(--color-ink) 92%, transparent);
    padding: 1.05rem 1.15rem 1.1rem;
    transition:
      border-color 0.35s ease,
      transform 0.35s ease,
      box-shadow 0.35s ease;
  }

  .process-station:hover .process-card {
    border-color: color-mix(in oklab, var(--color-axis) 48%, var(--color-line));
    box-shadow: var(--shadow-glow);
    transform: translateY(-2px);
  }

  .process-card-head {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.45rem;
  }

  .process-glyph {
    display: grid;
    width: 1.7rem;
    height: 1.7rem;
    place-items: center;
    color: var(--color-axis);
  }

  .process-glyph :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }

  .process-step {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-axis);
  }

  .process-card h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-paper);
  }

  .process-card > p {
    margin: 0.5rem 0 0;
    color: var(--color-mist);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .process-next {
    margin: 0.85rem 0 0;
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-mist);
  }

  .process-next span {
    color: var(--color-paper);
  }

  .process-next.is-last {
    color: var(--color-signal);
  }

  .process-station:nth-child(2) .process-node,
  .process-station:nth-child(5) .process-node,
  .process-station:nth-child(2) .process-step,
  .process-station:nth-child(5) .process-step,
  .process-station:nth-child(2) .process-glyph,
  .process-station:nth-child(5) .process-glyph {
    color: var(--color-signal);
  }

  .process-station:nth-child(2) .process-node,
  .process-station:nth-child(5) .process-node {
    border-color: color-mix(in oklab, var(--color-signal) 55%, var(--color-line));
    box-shadow: 0 0 0 6px var(--color-void), 0 0 22px color-mix(in oklab, var(--color-signal) 20%, transparent);
  }

  .process-station:nth-child(3) .process-node,
  .process-station:nth-child(6) .process-node,
  .process-station:nth-child(3) .process-step,
  .process-station:nth-child(6) .process-step,
  .process-station:nth-child(3) .process-glyph,
  .process-station:nth-child(6) .process-glyph {
    color: var(--color-pulse);
  }

  .process-station:nth-child(3) .process-node,
  .process-station:nth-child(6) .process-node {
    border-color: color-mix(in oklab, var(--color-pulse) 55%, var(--color-line));
    box-shadow: 0 0 0 6px var(--color-void), 0 0 22px color-mix(in oklab, var(--color-pulse) 20%, transparent);
  }

  .process-station:nth-child(2) .process-card,
  .process-station:nth-child(5) .process-card {
    background:
      linear-gradient(180deg, color-mix(in oklab, var(--color-signal) 8%, transparent), transparent 38%),
      color-mix(in oklab, var(--color-ink) 92%, transparent);
  }

  .process-station:nth-child(3) .process-card,
  .process-station:nth-child(6) .process-card {
    background:
      linear-gradient(180deg, color-mix(in oklab, var(--color-pulse) 8%, transparent), transparent 38%),
      color-mix(in oklab, var(--color-ink) 92%, transparent);
  }

  @media (min-width: 900px) {
    .process-track {
      flex-wrap: nowrap;
      justify-content: space-between;
      overflow: visible;
    }

    .process-spine {
      gap: 0.4rem;
    }

    .process-spine::before {
      left: 50%;
      margin-left: -1px;
    }

    .process-station {
      grid-template-columns: minmax(0, 1fr) 4.2rem minmax(0, 1fr);
      align-items: center;
      gap: 1.35rem;
    }

    .process-node {
      grid-column: 2;
      grid-row: 1;
      width: 3.45rem;
      height: 3.45rem;
    }

    .process-station:nth-child(odd) .process-card {
      grid-column: 1;
      grid-row: 1;
      text-align: right;
    }

    .process-station:nth-child(even) .process-card {
      grid-column: 3;
      grid-row: 1;
    }

    .process-station:nth-child(odd) .process-card-head {
      justify-content: flex-end;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .process-spine::before,
    .process-station:hover .process-card {
      transform: none;
    }
  }
</style>
