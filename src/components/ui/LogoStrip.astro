---
import type { Client } from '../../types';

type Props = {
  clients: Client[];
};

const { clients } = Astro.props;
---

<div class="logo-strip overflow-hidden border-y border-line" data-logo-strip>
  <p class="sr-only">Client marks. Animation pauses on hover, focus, and reduced motion.</p>
  <div class="flex gap-0">
    {[0, 1].map((copy) => (
      <ul class="logo-track flex min-w-full shrink-0" aria-hidden={copy === 1}>
        {clients.map((client) => (
          <li class="flex w-40 shrink-0 flex-col items-center justify-center border-r border-line px-4 py-6">
            <span class="font-display text-xl tracking-tight text-paper">{client.mark}</span>
            <span class="font-mono mt-1 text-[10px] uppercase tracking-[0.14em] text-mist">{client.name}</span>
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-100%);
    }
  }
  .logo-track {
    animation: marquee 42s linear infinite;
  }
  .logo-strip:hover .logo-track,
  .logo-strip:focus-within .logo-track {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-track {
      animation: none;
    }
  }
</style>
