---
import type { Client } from '../../types';

type Props = {
  clients: Client[];
};

const { clients } = Astro.props;
---

<div class="logo-strip overflow-hidden py-10" data-logo-strip>
  <p class="mb-8 text-center text-sm text-mist">Teams we have built with</p>
  <p class="sr-only">Client marks. Animation pauses on hover, focus, and reduced motion.</p>
  <div class="flex gap-0">
    {[0, 1].map((copy) => (
      <ul class="logo-track flex min-w-full shrink-0" aria-hidden={copy === 1}>
        {clients.map((client) => (
          <li class="flex w-44 shrink-0 flex-col items-center justify-center px-6 py-2">
            <span class="font-display text-xl font-medium tracking-tight text-mist">{client.mark}</span>
            <span class="mt-1 text-[11px] text-mist/80">{client.name}</span>
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-100%);
    }
  }
  .logo-track {
    animation: marquee 42s linear infinite;
  }
  .logo-strip:hover .logo-track,
  .logo-strip:focus-within .logo-track {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-track {
      animation: none;
    }
  }
</style>
