---
type Props = { class?: string };
---

<figure class:list={['flex items-end justify-center gap-4', Astro.props.class]} aria-label="Mobile device mockups">
  <div class="w-[42%] max-w-[180px] rounded-[1.6rem] border border-white/10 bg-white/5 p-2 backdrop-blur">
    <div class="mx-auto mb-2 h-1.5 w-10 rounded-full bg-line"></div>
    <div class="space-y-2 rounded-xl bg-void/80 p-3">
      <div class="h-16 rounded-lg border border-white/10 bg-slate/80"></div>
      <div class="h-2 w-3/4 rounded-full bg-axis/40"></div>
      <div class="h-2 w-1/2 rounded-full bg-line"></div>
      <div class="mt-3 grid grid-cols-2 gap-2">
        <div class="h-10 rounded-lg border border-white/10"></div>
        <div class="h-10 rounded-lg border border-axis/40"></div>
      </div>
    </div>
  </div>
  <div class="mb-6 w-[46%] max-w-[200px] rounded-[1.8rem] border border-axis/40 bg-white/5 p-2 shadow-[0_0_40px_color-mix(in_oklab,var(--color-pulse)_18%,transparent)] backdrop-blur">
    <div class="mx-auto mb-2 h-1.5 w-12 rounded-full bg-line"></div>
    <div class="space-y-2 rounded-xl bg-void/90 p-3">
      <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-pulse">session.ok</p>
      <p class="font-display text-lg text-paper">Field ticket</p>
      <div class="h-2 w-full rounded-full bg-line"></div>
      <div class="h-2 w-2/3 rounded-full bg-signal/50"></div>
      <div class="mt-4 h-24 rounded-lg border border-dashed border-white/15"></div>
    </div>
  </div>
</figure>
