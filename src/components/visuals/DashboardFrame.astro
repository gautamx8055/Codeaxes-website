---
type Props = { class?: string };
---

<figure class:list={['border border-line p-3', Astro.props.class]} aria-label="SaaS dashboard mockup">
  <div class="mb-3 flex items-center justify-between border-b border-line pb-2">
    <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-mist">workspace / production</p>
    <p class="font-mono text-[10px] text-pulse">live</p>
  </div>
  <div class="grid gap-3 sm:grid-cols-3">
    {['Active tenants', 'Job success', 'p95 latency'].map((label, i) => (
      <div class="border border-line bg-slate p-3">
        <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-mist">{label}</p>
        <p class="font-display mt-1 text-2xl text-paper">{['128', '99.4%', '142ms'][i]}</p>
      </div>
    ))}
  </div>
  <svg viewBox="0 0 360 90" class="mt-3 h-24 w-full" aria-hidden="true">
    <polyline fill="none" stroke="#7dd3fc" stroke-width="2" points="0,70 40,62 80,66 120,40 160,48 200,28 240,34 280,18 320,26 360,12" />
    <polyline fill="none" stroke="#93a4ff" stroke-width="1.5" opacity="0.8" points="0,78 40,74 80,70 120,68 160,60 200,58 240,52 280,48 320,44 360,40" />
  </svg>
</figure>
