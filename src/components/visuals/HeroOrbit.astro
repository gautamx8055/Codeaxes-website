---

<figure class="hero-orbit" aria-label="Live delivery axis">
  <div class="hero-orbit-stage">
    <div class="hero-orbit-glow" aria-hidden="true"></div>
    <div class="hero-orbit-ring hero-orbit-ring--outer" aria-hidden="true"></div>
    <div class="hero-orbit-ring hero-orbit-ring--inner" aria-hidden="true"></div>
    <div class="hero-orbit-core">
      <span class="hero-orbit-pulse" aria-hidden="true"></span>
      <p class="hero-orbit-kicker">Axis</p>
      <p class="hero-orbit-title">Live</p>
    </div>
    <div class="hero-orbit-card hero-orbit-card--a">
      <p>delivery.ok</p>
      <strong>99.4%</strong>
    </div>
    <div class="hero-orbit-card hero-orbit-card--b">
      <p>gate</p>
      <strong>Ready</strong>
    </div>
  </div>
</figure>

<style>
  .hero-orbit {
    position: relative;
    width: 100%;
  }

  .hero-orbit-stage {
    position: relative;
    isolation: isolate;
    aspect-ratio: 1 / 1;
    max-height: 28rem;
    border-radius: 1.75rem;
    border: 1px solid color-mix(in oklab, var(--color-axis) 22%, transparent);
    background:
      radial-gradient(circle at 50% 48%, color-mix(in oklab, var(--color-axis) 16%, transparent), transparent 42%),
      linear-gradient(180deg, color-mix(in oklab, var(--color-slate) 70%, transparent), var(--color-ink));
    box-shadow: 0 30px 80px color-mix(in oklab, black 28%, transparent);
  }

  .hero-orbit-glow {
    position: absolute;
    inset: 18%;
    border-radius: 999px;
    background: radial-gradient(circle, color-mix(in oklab, var(--color-axis) 28%, transparent), transparent 68%);
    filter: blur(12px);
    animation: orbit-breathe 6s ease-in-out infinite;
  }

  .hero-orbit-ring {
    position: absolute;
    border-radius: 999px;
    border: 1px dashed color-mix(in oklab, var(--color-axis) 32%, transparent);
    pointer-events: none;
  }

  .hero-orbit-ring--inner {
    inset: 24%;
    animation: orbit-spin 36s linear infinite;
  }

  .hero-orbit-ring--outer {
    inset: 10%;
    animation: orbit-spin 54s linear infinite reverse;
  }

  .hero-orbit-core {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 7.5rem;
    height: 7.5rem;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--color-axis) 40%, transparent);
    background: color-mix(in oklab, var(--color-void) 78%, transparent);
    box-shadow: 0 0 40px color-mix(in oklab, var(--color-axis) 28%, transparent);
    transform: translate(-50%, -50%);
    text-align: center;
  }

  .hero-orbit-pulse {
    position: absolute;
    inset: 12%;
    border-radius: 999px;
    border: 1px solid color-mix(in oklab, var(--color-axis) 45%, transparent);
    animation: orbit-breathe 2.8s ease-in-out infinite;
  }

  .hero-orbit-kicker {
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-axis);
  }

  .hero-orbit-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-paper);
  }

  .hero-orbit-card {
    position: absolute;
    z-index: 4;
    min-width: 7.5rem;
    padding: 0.7rem 0.85rem;
    border: 1px solid color-mix(in oklab, var(--color-axis) 28%, transparent);
    border-radius: 1rem;
    background: color-mix(in oklab, var(--color-void) 70%, transparent);
    backdrop-filter: blur(12px);
    animation: orbit-float 7s ease-in-out infinite;
  }

  .hero-orbit-card p {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-mist);
  }

  .hero-orbit-card strong {
    display: block;
    margin-top: 0.2rem;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-paper);
  }

  .hero-orbit-card--a {
    left: 6%;
    bottom: 10%;
  }

  .hero-orbit-card--b {
    right: 7%;
    top: 12%;
    animation-delay: -2.4s;
  }

  @keyframes orbit-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes orbit-breathe {
    0%,
    100% {
      opacity: 0.55;
      transform: scale(0.96);
    }
    50% {
      opacity: 1;
      transform: scale(1.04);
    }
  }

  @keyframes orbit-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  @media (max-width: 639px) {
    .hero-orbit-core {
      width: 6.2rem;
      height: 6.2rem;
    }

    .hero-orbit-card--b {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-orbit-ring,
    .hero-orbit-glow,
    .hero-orbit-pulse,
    .hero-orbit-card {
      animation: none;
    }
  }
</style>
