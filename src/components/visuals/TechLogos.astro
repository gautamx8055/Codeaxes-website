---
type Mark = {
  id: string;
  label: string;
  x: string;
  y: string;
  size: string;
  dur: string;
  delay: string;
  dx: string;
  dy: string;
};

const marks: Mark[] = [
  { id: 'python', label: 'Python', x: '3%', y: '10%', size: '2.5rem', dur: '11s', delay: '0s', dx: '10px', dy: '-16px' },
  { id: 'react', label: 'React', x: '91%', y: '12%', size: '2.4rem', dur: '13s', delay: '-2s', dx: '-12px', dy: '14px' },
  { id: 'typescript', label: 'TypeScript', x: '6%', y: '28%', size: '2.1rem', dur: '12s', delay: '-4s', dx: '8px', dy: '14px' },
  { id: 'nodejs', label: 'Node.js', x: '88%', y: '30%', size: '2.3rem', dur: '14s', delay: '-1s', dx: '-10px', dy: '-12px' },
  { id: 'docker', label: 'Docker', x: '2%', y: '52%', size: '2.6rem', dur: '15s', delay: '-6s', dx: '12px', dy: '8px' },
  { id: 'kubernetes', label: 'Kubernetes', x: '92%', y: '54%', size: '2.2rem', dur: '16s', delay: '-3s', dx: '-8px', dy: '14px' },
  { id: 'postgres', label: 'PostgreSQL', x: '5%', y: '74%', size: '2.3rem', dur: '12s', delay: '-5s', dx: '10px', dy: '-12px' },
  { id: 'go', label: 'Go', x: '90%', y: '76%', size: '2.5rem', dur: '13s', delay: '-7s', dx: '-12px', dy: '10px' },
];
---

<div class="tech-logos" aria-hidden="true">
  {
    marks.map((mark) => (
      <span
        class="tech-logo"
        style={`left:${mark.x};top:${mark.y};width:${mark.size};height:${mark.size};--dur:${mark.dur};--delay:${mark.delay};--dx:${mark.dx};--dy:${mark.dy}`}
      >
        <span class="sr-only">{mark.label}</span>
        {mark.id === 'python' && (
          <svg viewBox="0 0 24 24" role="img">
            <path fill="#3776AB" d="M12.1 2C7.6 2 8 4.2 8 4.2l.01 2.2h4.16v.66H5.9S2 6.9 2 12.12c0 5.2 2.9 5 2.9 5h1.73v-2.4s-.1-2.86 2.81-2.86h4.84s2.72.05 2.72-2.63V4.4S17.5 2 12.1 2zm-1.9 1.4a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8z" />
            <path fill="#FFD43B" d="M11.9 22c4.5 0 4.1-2.2 4.1-2.2l-.01-2.2H11.83v-.66h6.27S22 17.1 22 11.88c0-5.2-2.9-5-2.9-5h-1.73v2.4s.1 2.86-2.81 2.86H9.72S7 12.09 7 14.77V19.6S6.5 22 11.9 22zm1.9-1.4a.9.9 0 1 1 0-1.8.9.9 0 0 1 0 1.8z" />
          </svg>
        )}
        {mark.id === 'react' && (
          <svg viewBox="-11.5 -10.24 23 20.48" role="img">
            <circle r="2.05" fill="#61DAFB" />
            <g fill="none" stroke="#61DAFB" stroke-width="1">
              <ellipse rx="11" ry="4.2" />
              <ellipse rx="11" ry="4.2" transform="rotate(60)" />
              <ellipse rx="11" ry="4.2" transform="rotate(120)" />
            </g>
          </svg>
        )}
        {mark.id === 'typescript' && (
          <svg viewBox="0 0 24 24" role="img">
            <rect width="24" height="24" rx="4" fill="#3178C6" />
            <path fill="#fff" d="M14.4 10.3h-2.5V18H10v-7.7H7.6V8.5h6.8v1.8zm5.3 4.4c0 2.2-1.5 3.4-4 3.4-1.8 0-3.2-.8-3.8-2.1l1.9-.8c.3.8.9 1.3 1.9 1.3.9 0 1.4-.4 1.4-1.1 0-.6-.4-.9-1.7-1.2l-.8-.2c-1.9-.5-3.1-1.5-3.1-3.3 0-1.9 1.6-3.3 3.8-3.3 1.8 0 3 .7 3.7 2l-1.8.8c-.3-.6-.9-1-1.7-1-.8 0-1.3.4-1.3 1 0 .6.4.9 1.7 1.2l.8.2c2.1.5 3.2 1.5 3.2 3.4z" />
          </svg>
        )}
        {mark.id === 'nodejs' && (
          <svg viewBox="0 0 24 24" role="img">
            <path fill="#339933" d="M11.6.4 1.8 6v12l9.8 5.6L21.4 18V6L11.6.4zm0 2.1 7.4 4.2v8.6l-7.4 4.2-7.4-4.2V6.7l7.4-4.2z" />
            <path fill="#339933" d="M11.6 7.2c-1.9 0-3.1.8-3.7 2.3l1.7 1.1c.3-.8.8-1.2 1.8-1.2.9 0 1.6.5 1.6 1.3v.1c0 .7-.4 1-1.8 1.4-1.8.5-3 1.2-3 3 0 1.8 1.2 2.9 3.2 2.9 1.8 0 3-.7 3.7-2.2l-1.7-1.1c-.4.9-1 1.3-2 1.3-.8 0-1.4-.4-1.4-1.1 0-.7.5-1 1.9-1.4 1.8-.5 2.9-1.3 2.9-3.1 0-1.8-1.4-2.9-3.2-2.9z" />
          </svg>
        )}
        {mark.id === 'docker' && (
          <svg viewBox="0 0 24 24" role="img">
            <path fill="#2496ED" d="M4.1 10.4h2.2v2.1H4.1zm2.6 0h2.2v2.1H6.7zm2.6 0h2.2v2.1H9.3zm2.6 0h2.2v2.1h-2.2zM6.7 8h2.2v2.1H6.7zm2.6 0h2.2v2.1H9.3zm2.6 0h2.2v2.1h-2.2zm0-2.4h2.2V7.8h-2.2zm6.3 6.7c-.2-.1-.2-.4-.1-.6.3-1.1-.2-1.8-.2-2l-2 .4c0-.2-.2-.4-.5-.4H3.2c-.5 2.4.2 5.5 3.4 5.5 2.5 0 4.3-1.1 5.3-2.6 1 .8 2.4 1.1 3.8.7.1 0 2.2-.4 3.4-2.2z" />
          </svg>
        )}
        {mark.id === 'kubernetes' && (
          <svg viewBox="0 0 24 24" role="img">
            <path fill="#326CE5" d="M12 1.2 3.4 5.7v9.1c0 2.4 1.5 4.6 3.7 5.5L12 22.8l4.9-1.5c2.2-.9 3.7-3.1 3.7-5.5V5.7L12 1.2zm0 2.3 6.6 3.4v7.9c0 1.7-1 3.3-2.6 4L12 20.2l-4-1.4c-1.6-.7-2.6-2.3-2.6-4V6.9L12 3.5z" />
            <path fill="#326CE5" d="M12 8.2 8.7 14h1.5l.6-1.3h2.4L13.8 14h1.5L12 8.2zm.1 2.1.7 1.6h-1.5l.8-1.6z" />
          </svg>
        )}
        {mark.id === 'postgres' && (
          <svg viewBox="0 0 24 24" role="img">
            <path fill="#336791" d="M16.8 1.6c-1.1.1-2.4.8-3.3 2.1-.3.4-.6 1-.8 1.6-.2.1-.8.1-1.2.1-2.3 0-3.6 1.2-3.6 3.2 0 2.3 1.2 3.6 3.8 4.1v1.4H9.5v1.3h2.2v1.3H9.2v1.4h2.5V21h1.6v-2.3h2.5v-1.4h-2.5v-1.3h2.2v-1.3h-2.2v-1.4c2.8-.4 4.2-1.8 4.4-4.3.6-.2 1.1-.7 1.1-1.3 0-.6-.4-.9-.7-1.2.6-1.8.7-3.3.1-4.5-.8-1.6-2.2-2.3-3.6-2.2z" />
          </svg>
        )}
        {mark.id === 'go' && (
          <svg viewBox="0 0 24 24" role="img">
            <path fill="#00ADD8" d="M1.8 10.8c-.2 1.8 1.6 2.8 4.1 2.8 1.3 0 2.5-.3 3.5-.8 1.6.8 4.1 1.2 6.7 1.2 3.4 0 6.2-.8 7-1.8.2.4.3.8.3 1.2 0 2.4-4.4 4.4-9.8 4.4S3.8 15.8 3.8 13.4c0-.8.3-1.6.8-2.3-.9.1-1.9-.1-2.8-.3zm4.3-1.8c.2 0 .3 0 .3-.2l.1-.7H4.8c0 .5.6.9 1.3.9zm9.7 0c.2 0 .2 0 .3-.2l.1-.7h-1.8c.1.5.6.9 1.4.9zM6.4 7.2c-2.1 0-3.6.7-3.6 1.6 0 .4.2.7.6.9C4.7 8.8 7.1 8 10 8c.3-0.5.8-1 1.3-1.3-1.6-.4-3.3-.5-4.9-.5zm8.6 0c-1.5 0-2.8.3-3.7.8.6.2 1.1.6 1.4 1.1 1.1-.3 2.5-.4 4-.4 2.4 0 4.4.5 5.1 1.3.3-.2.5-.5.5-.8 0-.9-1.5-1.6-3.6-1.6h-3.7z" />
          </svg>
        )}
        {mark.id === 'aws' && (
          <svg viewBox="0 0 24 24" role="img">
            <path fill="#FF9900" d="M6.7 15.3c-2 1.4-4.9 2.1-4.9 2.1l.5.7s3.1-.8 5.4-2.4c2-1.3 3-2.7 3-2.7l-.8-.6s-.9 1.2-3.2 2.9zm13.3-1-1.4.9 3.4 1.1-2-2zm-8.6-8v7.8h1.6V8.7l3.4 5.5h1.5V6.3h-1.6v5.5L12.9 6.3h-.1z" />
          </svg>
        )}
        {mark.id === 'graphql' && (
          <svg viewBox="0 0 24 24" role="img">
            <path fill="#E10098" d="M4.2 14.6 12 19.1l7.8-4.5V9.4L12 4.9 4.2 9.4v5.2zm1.7-.3V10l6.1 3.5v4.1l-6.1-3.3zm13.2 0-6.1 3.3v-4.1L19.1 10v4.3zM12 6.4l6.1 3.5L12 13.4 5.9 9.9 12 6.4z" />
            <circle cx="12" cy="4.6" r="1.4" fill="#E10098" />
            <circle cx="20.2" cy="9.2" r="1.4" fill="#E10098" />
            <circle cx="20.2" cy="14.8" r="1.4" fill="#E10098" />
            <circle cx="12" cy="19.4" r="1.4" fill="#E10098" />
            <circle cx="3.8" cy="14.8" r="1.4" fill="#E10098" />
            <circle cx="3.8" cy="9.2" r="1.4" fill="#E10098" />
          </svg>
        )}
      </span>
    ))
  }
</div>
