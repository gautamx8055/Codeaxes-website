---
import { services } from '../../data/services';
import { caseStudies } from '../../data/case-studies';
---

<div data-case-filters>
  <div class="mb-8 grid gap-4 md:grid-cols-3">
    <div>
      <label class="mb-2 block text-sm" for="case-q">Search</label>
      <input id="case-q" data-q class="w-full border border-line px-3 py-3 text-paper" placeholder="Client, stack, industry" />
    </div>
    <div>
      <label class="mb-2 block text-sm" for="case-industry">Industry</label>
      <select id="case-industry" data-filter-industry class="w-full border border-line px-3 py-3 text-paper">
        <option value="">All industries</option>
        {[...new Set(caseStudies.map((study) => study.industry))].map((industry) => (
          <option value={industry}>{industry}</option>
        ))}
      </select>
    </div>
    <div>
      <label class="mb-2 block text-sm" for="case-service">Service</label>
      <select id="case-service" data-filter-service class="w-full border border-line px-3 py-3 text-paper">
        <option value="">All services</option>
        {services.map((service) => (
          <option value={service.slug}>{service.name}</option>
        ))}
      </select>
    </div>
  </div>
  <p class="font-mono mb-6 text-[11px] text-mist" data-count aria-live="polite"></p>
  <div class="grid gap-6" data-grid>
    <slot />
  </div>
  <p class="hidden text-mist" data-empty>No case studies match those filters.</p>
</div>

<script>
  const root = document.querySelector('[data-case-filters]');
  if (root) {
    const q = root.querySelector<HTMLInputElement>('[data-q]');
    const industry = root.querySelector<HTMLSelectElement>('[data-filter-industry]');
    const service = root.querySelector<HTMLSelectElement>('[data-filter-service]');
    const cards = [...root.querySelectorAll<HTMLAnchorElement>('a[data-industry]')];
    const empty = root.querySelector('[data-empty]');
    const count = root.querySelector('[data-count]');

    const apply = () => {
      const query = q?.value.toLowerCase() ?? '';
      const ind = industry?.value ?? '';
      const svc = service?.value ?? '';
      let visible = 0;
      cards.forEach((card) => {
        const hay = card.textContent?.toLowerCase() ?? '';
        const match =
          (!query || hay.includes(query)) &&
          (!ind || card.dataset.industry === ind) &&
          (!svc || (card.dataset.services ?? '').includes(svc));
        card.hidden = !match;
        if (match) visible += 1;
      });
      empty?.classList.toggle('hidden', visible !== 0);
      if (count) count.textContent = `${visible} studies`;
    };
    q?.addEventListener('input', apply);
    industry?.addEventListener('change', apply);
    service?.addEventListener('change', apply);
    apply();
  }
</script>
