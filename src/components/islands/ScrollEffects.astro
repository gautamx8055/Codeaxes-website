<div class="scroll-progress" aria-hidden="true" data-scroll-progress>
  <span></span>
</div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const bar = document.querySelector<HTMLElement>('[data-scroll-progress] span');
  let frame = 0;
  const paint = () => {
    frame = 0;
    const max = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
    const y = Math.max(0, window.scrollY);
    if (bar) bar.style.transform = `scaleX(${max > 0 ? Math.min(1, y / max) : 0})`;
  };
  const onScroll = () => {
    if (!frame) frame = requestAnimationFrame(paint);
  };
  paint();
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll, { passive: true });

  const reveal = document.querySelectorAll('[data-reveal], [data-reveal-stagger]');
  if (reduce) {
    reveal.forEach((node) => node.classList.add('is-inview'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-inview');
          io.unobserve(entry.target);
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
    );
    reveal.forEach((node) => io.observe(node));
  }
</script>
