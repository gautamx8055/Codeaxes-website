---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import Button from '../../components/ui/Button.astro';
import JobCard from '../../components/ui/JobCard.astro';
import { listJobs } from '../../lib/jobs';
import { site } from '../../data/site';
import type { Job, JobBrand } from '../../types';

const jobs = await listJobs();
const boards: {
  id: JobBrand;
  eyebrow: string;
  title: string;
  kicker: string;
  empty: string;
  jobs: Job[];
}[] = [
  {
    id: 'codeaxes',
    eyebrow: 'Codeaxes',
    title: 'Product engineering roles.',
    kicker: 'Seats on Codeaxes delivery squads: product, engineering, design, and operations.',
    empty: 'No Codeaxes roles are open right now. Send a note through Contact if you think you should be here anyway.',
    jobs: jobs.filter((job) => job.brand === 'codeaxes'),
  },
  {
    id: 'kuroaxe',
    eyebrow: 'Kuroaxe',
    title: 'Marketing roles at our partner brand.',
    kicker: 'Kuroaxe is the marketing services brand. Open seats are listed here, on this careers page.',
    empty: 'No Kuroaxe roles are open right now. Check back, or visit the Kuroaxe site for the brand.',
    jobs: jobs.filter((job) => job.brand === 'kuroaxe'),
  },
];
---

<BaseLayout
  title="Careers"
  description="Open roles at Codeaxes and Kuroaxe. Product engineering seats and marketing seats, published from the hiring workspace."
  path="/careers"
>
  <PageHero
    eyebrow="Careers"
    title="Two brands. Two hiring tracks."
    body="Codeaxes hires for product engineering. Kuroaxe hires for marketing. Each posting is published from the hiring workspace and lists the team, location, and how to apply."
    layout="rail"
  >
    <Button slot="actions" href="#codeaxes">Codeaxes roles</Button>
    <Button slot="actions" href="#kuroaxe" variant="secondary">Kuroaxe roles</Button>
  </PageHero>

  {
    boards.map((board) => (
      <Section
        id={board.id}
        index={board.id === 'codeaxes' ? '01' : '02'}
        tone={board.id === 'codeaxes' ? 'muted' : 'ink'}
        eyebrow={board.eyebrow}
        title={board.title}
        kicker={board.kicker}
        split
      >
        {board.jobs.length > 0 ? (
          <div class="grid gap-4 md:grid-cols-2" data-reveal-stagger data-job-list={board.id}>
            {board.jobs.map((job) => (
              <JobCard job={job} />
            ))}
          </div>
        ) : (
          <div data-job-list={board.id}>
            <div class="border border-line p-8">
            <p class="font-display text-2xl text-paper">No live {board.eyebrow} roles.</p>
            <p class="mt-3 max-w-xl text-mist">{board.empty}</p>
            <div class="mt-6 flex flex-wrap gap-3">
              {board.id === 'kuroaxe' ? (
                <Button href={site.kuroaxe.url} external>
                  {site.kuroaxe.name}
                </Button>
              ) : (
                <Button href="/contact">Contact Codeaxes</Button>
              )}
            </div>
            </div>
          </div>
        )}
      </Section>
    ))
  }

  <script>
    const labels = {
      brand: { codeaxes: 'Codeaxes', kuroaxe: 'Kuroaxe' },
      employment: { 'full-time': 'Full-time', 'part-time': 'Part-time', contract: 'Contract', internship: 'Internship' },
      workplace: { remote: 'Remote', hybrid: 'Hybrid', onsite: 'On-site' },
    };
    const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

    const escapeHtml = (value: string) =>
      value.replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char] ?? char);

    const card = (job: {
      slug: string;
      title: string;
      brand: 'codeaxes' | 'kuroaxe';
      department: string;
      summary: string;
      location: string;
      employmentType: keyof typeof labels.employment;
      workplace: keyof typeof labels.workplace;
    }) => {
      const href = `${base}careers/role?slug=${encodeURIComponent(job.slug)}`;
      return `<a href="${href}" class="group flex h-full flex-col rounded-2xl border border-line p-6 transition hover:border-axis">
        <p class="font-mono mb-4 text-[11px] uppercase tracking-[0.16em] text-axis">${escapeHtml(labels.brand[job.brand])} · ${escapeHtml(job.department)}</p>
        <h3 class="font-display text-2xl tracking-tight text-paper">${escapeHtml(job.title)}</h3>
        <p class="mt-3 flex-1 text-sm leading-relaxed text-mist">${escapeHtml(job.summary)}</p>
        <ul class="mt-5 flex flex-wrap gap-2">
          <li class="border border-line px-2 py-1 text-[11px] uppercase tracking-[0.12em] text-mist">${escapeHtml(job.location)}</li>
          <li class="border border-line px-2 py-1 text-[11px] uppercase tracking-[0.12em] text-mist">${escapeHtml(labels.employment[job.employmentType] ?? job.employmentType)}</li>
          <li class="border border-line px-2 py-1 text-[11px] uppercase tracking-[0.12em] text-mist">${escapeHtml(labels.workplace[job.workplace] ?? job.workplace)}</li>
        </ul>
        <p class="font-mono mt-6 text-[11px] uppercase tracking-[0.16em] text-axis">Open role →</p>
      </a>`;
    };

    const paint = (jobs: Array<{ brand: 'codeaxes' | 'kuroaxe' }>) => {
      for (const brand of ['codeaxes', 'kuroaxe'] as const) {
        const list = document.querySelector<HTMLElement>(`[data-job-list="${brand}"]`);
        if (!list) continue;
        const mine = jobs.filter((job) => job.brand === brand);
        if (!mine.length) continue;
        list.className = 'grid gap-4 md:grid-cols-2';
        list.innerHTML = mine.map((job) => card(job as Parameters<typeof card>[0])).join('');
      }
    };

    fetch(`${base}api/jobs`)
      .then((response) => (response.ok ? response.json() : null))
      .then((payload: { jobs?: Array<{ brand: 'codeaxes' | 'kuroaxe' }> } | null) => {
        if (payload?.jobs) paint(payload.jobs);
      })
      .catch(() => undefined);
  </script>

  <CtaBand
    eyebrow="Hiring"
    title="Roles are published from the hiring workspace."
    body="Apply from the role page. Codeaxes and Kuroaxe postings are listed separately above. Email us if the seat is not listed yet."
    primary={{ label: 'Email us', href: `mailto:${site.email}?subject=Careers` }}
    secondary={{ label: 'Start a project', href: '/contact' }}
  />
</BaseLayout>
