---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import Accordion from '../../components/ui/Accordion.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import Button from '../../components/ui/Button.astro';
import ServiceCard from '../../components/ui/ServiceCard.astro';
import ServiceVisual from '../../components/visuals/ServiceVisual.astro';
import { getService, services, serviceGroups, getServicesByGroup } from '../../data/services';
import { site } from '../../data/site';
import { extraFaqsForService } from '../../data/faqs';
import { findTechnology } from '../../data/technologies';
import { deliveryProcess } from '../../data/process';
import { withBase } from '../../lib/seo';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug } }));
}

const service = getService(Astro.params.slug ?? '');
if (!service) throw new Error('Unknown service');
const group = serviceGroups.find((item) => item.id === service.groupId)!;
const related = getServicesByGroup(group.id).filter((item) => item.slug !== service.slug);
const faqs = extraFaqsForService(service.slug);
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'Service',
  name: service.name, description: service.summary, serviceType: group.name,
  provider: { '@type': 'Organization', name: site.name, url: site.url },
  url: `${site.url}/services/${service.slug}`, areaServed: 'Global',
};
---

<BaseLayout title={service.name} description={service.summary} path={`/services/${service.slug}`} jsonLd={jsonLd}>
  <PageHero eyebrow={group.name} title={service.name} body={service.summary}>
    <ServiceVisual kind={service.visual} />
    <Button slot="actions" href="/contact">Discuss your project</Button>
    <Button slot="actions" href={`/services#${group.id}`} variant="secondary">Explore {group.name}</Button>
  </PageHero>
  <Section index="01" tone="muted" eyebrow="Capabilities" title="From the challenge to the system." kicker={group.summary} split>
    <div class="grid gap-6 md:grid-cols-3">
      {service.capabilities.map((item, index) => (
        <article class="border-t border-line pt-5">
          <p class="kicker mb-4">{String(index + 1).padStart(2, '0')}</p>
          <h3 class="font-display text-2xl text-paper">{item.title}</h3>
          <p class="mt-3 text-mist">{item.body}</p>
        </article>
      ))}
    </div>
  </Section>
  <Section index="02" eyebrow="Technology" title="A stack shaped by the work." kicker="Tools are selected against your architecture, operating requirements, and existing systems. Explore the complete technology catalogue for the wider ecosystem." split>
    <ul class="catalogue-chips">
      {service.stack.map((name) => {
        const tech = findTechnology(name);
        return <li><a href={withBase(tech ? `/about/technologies/${tech.slug}` : '/about/technologies')}>{name}<span aria-hidden="true"> ↗</span></a></li>;
      })}
    </ul>
  </Section>
  <Section index="03" tone="ink" eyebrow="Delivery" title="One connected engineering process.">
    <ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {deliveryProcess.map((step, index) => (
        <li class="border-t border-line pt-4">
          <p class="kicker mb-2">{String(index + 1).padStart(2, '0')}</p>
          <h3 class="font-display text-xl text-paper">{step.title}</h3>
          <p class="mt-2 text-sm text-mist">{step.body}</p>
        </li>
      ))}
    </ol>
  </Section>
  <Section index="04" tone="muted" eyebrow={group.name} title="Connected capabilities.">
    <div class="grid gap-4 md:grid-cols-2">{related.map((item) => <ServiceCard service={item} />)}</div>
  </Section>
  {faqs.length > 0 && <Section eyebrow="FAQ" title={`Questions about ${service.name}.`}><Accordion items={faqs} name={service.slug} /></Section>}
  <CtaBand title="Put the next step in motion." body={`Talk to us about ${service.name.toLowerCase()} and the constraints your team is working with.`} primary={site.cta.primary} secondary={{ label: 'Industry solutions', href: '/about/industries' }} />
</BaseLayout>
