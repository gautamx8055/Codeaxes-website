---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import Accordion from '../../components/ui/Accordion.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import CaseStudyCard from '../../components/ui/CaseStudyCard.astro';
import Button from '../../components/ui/Button.astro';
import ServiceVisual from '../../components/visuals/ServiceVisual.astro';
import { getService, services } from '../../data/services';
import { getCaseStudiesBySlug } from '../../data/case-studies';
import { site } from '../../data/site';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug } }));
}

const service = getService(Astro.params.slug ?? '');
if (!service) throw new Error('Unknown service');

const related = getCaseStudiesBySlug(service.relatedCaseStudies);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name,
  description: service.summary,
  provider: { '@type': 'Organization', name: site.name, url: site.url },
  url: `${site.url}/services/${service.slug}`,
  areaServed: 'Global',
};
---

<BaseLayout title={service.name} description={service.summary} path={`/services/${service.slug}`} jsonLd={jsonLd}>
  <PageHero eyebrow={service.heroEyebrow} title={service.heroTitle} body={service.heroBody}>
    <ServiceVisual kind={service.visual} />
    <Button slot="actions" href="/contact">Start a project</Button>
    <Button slot="actions" href="/about/case-studies" variant="secondary">Related work</Button>
  </PageHero>

  <Section eyebrow="The work" title={service.tagline} kicker={service.explanation} />

  <Section eyebrow="Problems" title="What this service is for." class="border-y border-line">
    <ol class="grid gap-6 md:grid-cols-2">
      {
        service.problems.map((problem, index) => (
          <li class="border-t border-line pt-4">
            <p class="font-mono text-[11px] text-pulse">{String(index + 1).padStart(2, '0')}</p>
            <p class="mt-2 text-paper">{problem}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section eyebrow="Capabilities" title="What we actually deliver.">
    <div class="grid gap-8 md:grid-cols-2">
      {
        service.capabilities.map((item) => (
          <article>
            <h3 class="font-display text-xl text-paper">{item.title}</h3>
            <p class="mt-2 text-mist">{item.body}</p>
          </article>
        ))
      }
    </div>
    <ul class="mt-12 grid gap-3 border border-line p-6 md:grid-cols-2">
      {service.deliverables.map((item) => <li class="text-sm text-paper">▹ {item}</li>)}
    </ul>
  </Section>

  <Section eyebrow="Workflow" title="How this engagement runs." class="border-y border-line">
    <ol class="grid gap-6 md:grid-cols-5">
      {
        service.process.map((step, index) => (
          <li>
            <p class="font-mono text-[11px] text-pulse">{String(index + 1).padStart(2, '0')}</p>
            <h3 class="font-display mt-2 text-lg text-paper">{step.title}</h3>
            <p class="mt-2 text-sm text-mist">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section eyebrow="Fit" title="Industries and stack.">
    <div class="grid gap-10 md:grid-cols-2">
      <div>
        <h3 class="font-mono mb-4 text-[11px] uppercase tracking-[0.16em] text-mist">Industries</h3>
        <ul class="flex flex-wrap gap-2">
          {service.industries.map((item) => <li class="border border-line px-3 py-1 text-sm text-paper">{item}</li>)}
        </ul>
      </div>
      <div>
        <h3 class="font-mono mb-4 text-[11px] uppercase tracking-[0.16em] text-mist">Typical stack</h3>
        <ul class="flex flex-wrap gap-2">
          {service.stack.map((item) => (
            <li>
              <a href="/about/technologies" class="border border-line px-3 py-1 text-sm text-mist hover:text-pulse">
                {item}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <Section eyebrow="Use cases" title="Where this shows up in production.">
    <div class="grid gap-6 md:grid-cols-2">
      {
        service.useCases.map((item) => (
          <article class="border border-line p-6">
            <h3 class="font-display text-xl text-paper">{item.title}</h3>
            <p class="mt-3 text-mist">{item.body}</p>
          </article>
        ))
      }
    </div>
    <ul class="mt-10 grid gap-3 md:grid-cols-2">
      {service.benefits.map((item) => <li class="border-l border-pulse pl-4 text-paper">{item}</li>)}
    </ul>
  </Section>

  {
    related.length > 0 && (
      <Section eyebrow="Work" title="Related case studies.">
        <div class="grid gap-6">
          {related.map((study) => (
            <CaseStudyCard study={study} />
          ))}
        </div>
      </Section>
    )
  }

  <Section eyebrow="FAQ" title={`Questions about ${service.shortName}.`}>
    <Accordion items={service.faqs} name={service.slug} />
  </Section>

  <CtaBand title={`Start a ${service.shortName} conversation.`} primary={site.cta.primary} secondary={{ label: 'All services', href: '/services' }} />
</BaseLayout>
