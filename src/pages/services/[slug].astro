---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import Accordion from '../../components/ui/Accordion.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import CaseStudyCard from '../../components/ui/CaseStudyCard.astro';
import Button from '../../components/ui/Button.astro';
import ServiceVisual from '../../components/visuals/ServiceVisual.astro';
import { getService, services } from '../../data/services';
import { getCaseStudiesBySlug } from '../../data/case-studies';
import { site } from '../../data/site';
import { findTechnology } from '../../data/technologies';
import { withBase } from '../../lib/seo';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug } }));
}

const service = getService(Astro.params.slug ?? '');
if (!service) throw new Error('Unknown service');

const related = getCaseStudiesBySlug(service.relatedCaseStudies);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name,
  description: service.summary,
  provider: { '@type': 'Organization', name: site.name, url: site.url },
  url: `${site.url}/services/${service.slug}`,
  areaServed: 'Global',
};
---

<BaseLayout title={service.name} description={service.summary} path={`/services/${service.slug}`} jsonLd={jsonLd}>
  <PageHero eyebrow={service.heroEyebrow} title={service.heroTitle} body={service.heroBody}>
    <ServiceVisual kind={service.visual} />
    <Button slot="actions" href="/contact">Book consultation</Button>
    <Button slot="actions" href="/about/case-studies" variant="secondary">Related work</Button>
  </PageHero>

  <Section index="01" tone="muted" eyebrow="The work" title={service.tagline} kicker={service.explanation} split />

  <Section index="02" eyebrow="Problems" title="What this service is for.">
    <ol class="grid gap-6 md:grid-cols-2">
      {
        service.problems.map((problem, index) => (
          <li class="border-t border-line pt-4">
            <p class="font-mono text-[11px] text-pulse">{String(index + 1).padStart(2, '0')}</p>
            <p class="mt-2 text-paper">{problem}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section index="03" tone="ink" eyebrow="Capabilities" title="What we actually deliver.">
    <div class="grid gap-8 md:grid-cols-2">
      {
        service.capabilities.map((item) => (
          <article>
            <h3 class="font-display text-xl text-paper">{item.title}</h3>
            <p class="mt-2 text-mist">{item.body}</p>
          </article>
        ))
      }
    </div>
    <ul class="mt-12 grid gap-3 border border-line p-6 md:grid-cols-2">
      {service.deliverables.map((item) => <li class="text-sm text-paper">▹ {item}</li>)}
    </ul>
  </Section>

  <Section index="04" tone="muted" eyebrow="Workflow" title="How this engagement runs.">
    <ol class="grid gap-6 sm:grid-cols-2 xl:grid-cols-5">
      {
        service.process.map((step, index) => (
          <li>
            <p class="font-mono text-[11px] text-pulse">{String(index + 1).padStart(2, '0')}</p>
            <h3 class="font-display mt-2 text-lg text-paper">{step.title}</h3>
            <p class="mt-2 text-sm text-mist">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section class="fit-section" index="05" eyebrow="Fit" title="Industries and stack.">
    <div class="fit-grid">
      <article class="fit-panel">
        <header>
          <h3>Industries</h3>
          <p>{service.industries.length} sectors</p>
        </header>
        <ul class="fit-industries">
          {
            service.industries.map((item) => (
              <li>
                <span aria-hidden="true" />
                {item}
              </li>
            ))
          }
        </ul>
      </article>
      <article class="fit-panel is-stack">
        <header>
          <h3>Typical stack</h3>
          <p>Tools we actually operate</p>
        </header>
        <ul class="fit-stack">
          {
            service.stack.map((item) => {
              const tech = findTechnology(item);
              return (
                <li>
                  <a href={withBase(tech ? `/about/technologies/${tech.slug}` : '/about/technologies')}>{item}</a>
                </li>
              );
            })
          }
        </ul>
      </article>
    </div>
  </Section>

  <Section index="06" tone="ink" eyebrow="Use cases" title="Where this shows up in production.">
    <div class="grid gap-6 md:grid-cols-2">
      {
        service.useCases.map((item) => (
          <article class="border border-line p-6">
            <h3 class="font-display text-xl text-paper">{item.title}</h3>
            <p class="mt-3 text-mist">{item.body}</p>
          </article>
        ))
      }
    </div>
    <ul class="mt-10 grid gap-3 md:grid-cols-2">
      {service.benefits.map((item) => <li class="border-l border-pulse pl-4 text-paper">{item}</li>)}
    </ul>
  </Section>

  {
    related.length > 0 && (
      <Section index="07" tone="muted" eyebrow="Work" title="Related case studies.">
        <div class="grid gap-5 md:grid-cols-2">
          {related.map((study) => (
            <CaseStudyCard study={study} />
          ))}
        </div>
      </Section>
    )
  }

  <Section index="08" eyebrow="FAQ" title={`Questions about ${service.shortName}.`}>
    <Accordion items={service.faqs} name={service.slug} />
  </Section>

  <CtaBand title={`Start a ${service.shortName} conversation.`} primary={site.cta.primary} secondary={{ label: 'All services', href: '/services' }} />
</BaseLayout>

<style>
  .fit-section :global(.section-head) {
    margin-bottom: 2rem;
  }

  .fit-grid {
    display: grid;
    gap: 1rem;
  }

  .fit-panel {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: 1.25rem;
    background: #ffffff;
    padding: 1.25rem;
  }

  .fit-panel header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line);
  }

  .fit-panel h3 {
    margin: 0;
    color: var(--paper);
    font-size: 1.15rem;
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.25;
  }

  .fit-panel header p {
    margin: 0;
    color: var(--mist);
    font-size: 0.8rem;
  }

  .fit-industries,
  .fit-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .fit-industries li,
  .fit-stack a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    border-radius: 999px;
    padding: 0.35rem 0.95rem;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .fit-industries li {
    gap: 0.5rem;
    background: #f3f7fb;
    color: var(--paper);
  }

  .fit-industries li span {
    width: 0.45rem;
    height: 0.45rem;
    flex: none;
    border-radius: 999px;
    background: #2f62a8;
  }

  .fit-industries li:nth-child(even) span {
    background: #3d944c;
  }

  .fit-stack a {
    background: #e7f1fb;
    color: #16386e;
  }

  .fit-stack a:hover {
    background: #2f62a8;
    color: #ffffff;
  }

  @media (min-width: 768px) {
    .fit-grid {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }

    .fit-panel {
      padding: 1.4rem 1.4rem 1.5rem;
    }
  }

  @media (max-width: 767px) {
    .fit-section :global(.section-head) {
      margin-bottom: 1.25rem;
    }
  }
</style>
