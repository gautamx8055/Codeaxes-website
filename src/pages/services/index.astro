---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import ServiceCard from '../../components/ui/ServiceCard.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import PageHero from '../../components/ui/PageHero.astro';
import CoverDeck from '../../components/ui/CoverDeck.astro';
import CoverFace from '../../components/ui/CoverFace.astro';
import ServiceVisual from '../../components/visuals/ServiceVisual.astro';
import { services } from '../../data/services';
import { site } from '../../data/site';
import { withBase } from '../../lib/seo';
---

<BaseLayout
  title="Services"
  description="Codeaxes services: AI automation, mobile, SaaS, PaaS, QA, custom and product development, blockchain, project data, games, cloud, 2D animation, and DevOps."
  path="/services"
>
  <PageHero
    eyebrow="Services"
    title="Pick the axis your product is missing."
    body="Thirteen practices, shared engineering standards. Every page explains problems, delivery, stack, and how we measure done."
    layout="rail"
  />
  <Section tone="muted">
    <CoverDeck label="Services">
      {
        services.map((service) => (
          <a href={withBase(`/services/${service.slug}`)} data-cover-card data-cover-id={service.slug}>
            <CoverFace kicker="Service" title={service.name} body={service.tagline}>
              <ServiceVisual kind={service.visual} />
            </CoverFace>
          </a>
        ))
      }
    </CoverDeck>
    <div class="mt-12 grid gap-4 md:grid-cols-2">
      {services.map((service, index) => <ServiceCard service={service} index={String(index + 1).padStart(2, '0')} />)}
    </div>
  </Section>
  <CtaBand title="Not sure where to start?" body="Tell us the operational bottleneck. We’ll map it to a service." primary={site.cta.primary} />
</BaseLayout>
