---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import CatalogueFilter from '../../components/ui/CatalogueFilter.astro';
import { industries, legacyIndustryAnchors } from '../../data/industries';
import { engineeringPractices, catalogueCounts } from '../../data/catalogue';
import { site } from '../../data/site';
---

<BaseLayout title="Industries" description="Enterprise engineering and technology solutions across 18 industries, from aerospace and automotive to healthcare, manufacturing, energy, and agriculture." path="/about/industries">
  <PageHero eyebrow="Industry solutions" title="Built for the world you operate in." body={`${catalogueCounts.industries} industries. Connected engineering practices. Explore the systems, platforms, and intelligent operations we can help you develop.`} layout="rail" />
  <nav class="catalogue-jump" aria-label="Industry directory">
    {industries.map((industry) => <a href={`#${industry.slug}`}>{industry.name}</a>)}
    <a href="#cross-industry-practices">Cross-industry practices</a>
  </nav>
  <CatalogueFilter label="Find an industry or solution" placeholder="Search rail, digital twins, medical devices…" />
  <div class="catalogue-grid mx-auto grid max-w-6xl gap-5 px-4 py-10 sm:px-5 md:grid-cols-2 md:px-8 md:py-16">
    {industries.map((industry, index) => (
      <article id={industry.slug} data-catalogue-entry class="catalogue-panel">
        {Object.entries(legacyIndustryAnchors).filter(([, target]) => target === industry.slug).map(([old]) => <span id={old} class="catalogue-anchor" aria-hidden="true" />)}
        <p class="kicker mb-4">{String(index + 1).padStart(2, '0')} / Industry</p>
        <h2 class="font-display text-2xl text-paper sm:text-3xl">{industry.name}</h2>
        <p class="mt-3 text-sm text-mist">{industry.summary}</p>
        <h3 class="mb-3 mt-6 text-sm font-semibold text-axis">Enterprise engineering & technology solutions</h3>
        <ul class="catalogue-solutions">{industry.solutions.map((solution) => <li>{solution}</li>)}</ul>
      </article>
    ))}
  </div>
  <Section id="cross-industry-practices" eyebrow="Connected expertise" title="Engineering practices across industries." kicker="These common practices support delivery across multiple industries, bringing product, systems, operations, and experience together." tone="muted" split>
    <span id="saas-technology" aria-hidden="true" />
    <ol class="grid gap-x-10 gap-y-4 md:grid-cols-2">
      {engineeringPractices.map((practice, index) => (
        <li class="flex items-start gap-4 border-t border-line pt-4 text-paper"><span class="font-mono text-sm text-axis">{String(index + 1).padStart(2, '0')}</span>{practice}</li>
      ))}
    </ol>
  </Section>
  <CtaBand title="Bring your industry's next challenge." body="Let’s connect the right engineering practices to your operating environment." primary={site.cta.primary} />
</BaseLayout>
