---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import { clients } from '../../data/clients';
import { site } from '../../data/site';
---

<BaseLayout
  title="Our Clients"
  description="A showcase of Codeaxes client engagements across SaaS, healthcare, fintech, commerce, logistics, and operations."
  path="/about/clients"
>
  <PageHero
    eyebrow="Clients"
    title="Teams who needed software that could be operated."
    body="Placeholder company marks for a production-ready structure. Replace names and outcomes from src/data/clients.ts."
    layout="rail"
  />
  <Section tone="muted">
    <div class="grid gap-4 md:grid-cols-2">
      {
        clients.map((client) => (
          <article class="grid grid-cols-[4.5rem_1fr] gap-4 rounded-2xl border border-line p-5">
            <div class="grid place-items-center border border-line bg-void font-display text-xl text-pulse">{client.mark}</div>
            <div>
              <h2 class="font-display text-xl text-paper">{client.name}</h2>
              <p class="font-mono mt-1 text-[11px] uppercase tracking-[0.14em] text-mist">
                {client.sector} · {client.category}
              </p>
              <p class="mt-3 text-sm text-paper">{client.engagement}</p>
              <p class="mt-2 text-sm text-mist">{client.outcome}</p>
            </div>
          </article>
        ))
      }
    </div>
  </Section>
  <CtaBand title="Become the next operating story." primary={site.cta.primary} />
</BaseLayout>
