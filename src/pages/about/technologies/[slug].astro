---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import Section from '../../../components/ui/Section.astro';
import CtaBand from '../../../components/ui/CtaBand.astro';
import Button from '../../../components/ui/Button.astro';
import { findTechnology, getTechnologiesByCategory, getTechnology, techCategories, technologies } from '../../../data/technologies';
import { getService } from '../../../data/services';
import { site } from '../../../data/site';
import { withBase } from '../../../lib/seo';

export function getStaticPaths() {
  return technologies.map((tech) => ({ params: { slug: tech.slug } }));
}

const tech = getTechnology(Astro.params.slug ?? '');
if (!tech) throw new Error('Unknown technology');

const category = techCategories.find((item) => item.id === tech.category);
const siblings = getTechnologiesByCategory(tech.category).filter((item) => item.slug !== tech.slug);
const relatedServices = tech.relatedServices.map((slug) => getService(slug)).filter((item) => item !== undefined);
---

<BaseLayout title={tech.name} description={tech.summary} path={`/about/technologies/${tech.slug}`}>
  <PageHero eyebrow={category?.name ?? tech.category} title={tech.name} body={tech.summary} layout="rail">
    <Button slot="actions" href={site.cta.primary.href}>{site.cta.primary.label}</Button>
    <Button slot="actions" href="/about/technologies" variant="secondary">All technologies</Button>
  </PageHero>

  <Section index="01" tone="muted" eyebrow="What it is" title="In production terms.">
    <div class="tech-copy">
      <p>{tech.what}</p>
      <p>{tech.why}</p>
    </div>
  </Section>

  <Section index="02" eyebrow="Fit" title="Best-fit use cases.">
    <ol class="tech-cases">
      {
        tech.useCases.map((item, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            {item}
          </li>
        ))
      }
    </ol>
  </Section>

  <Section index="03" tone="ink" eyebrow="Trade-offs" title="Benefits and limits.">
    <div class="tech-split">
      <article>
        <h3>Benefits</h3>
        <ul>
          {tech.benefits.map((item) => <li>{item}</li>)}
        </ul>
      </article>
      <article>
        <h3>Limitations</h3>
        <ul>
          {tech.limitations.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </div>
  </Section>

  <Section index="04" tone="muted" eyebrow="Ecosystem" title="Compatible technologies.">
    <ul class="tech-chips">
      {
        tech.compatible.map((item) => {
          const match = findTechnology(item);
          return (
            <li>
              {match && match.slug !== tech.slug ? (
                <a href={withBase(`/about/technologies/${match.slug}`)}>{item}</a>
              ) : (
                <span>{item}</span>
              )}
            </li>
          );
        })
      }
    </ul>
  </Section>

  <Section index="05" eyebrow="In the field" title="Example applications.">
    <ul class="tech-apps">
      {tech.applications.map((item) => <li>{item}</li>)}
    </ul>
  </Section>

  <Section index="06" tone="ink" eyebrow="Services" title="Where this stack shows up.">
    <ul class="tech-services">
      {
        relatedServices.map((service) => (
          <li>
            <a href={withBase(`/services/${service.slug}`)}>
              <strong>{service.name}</strong>
              <span>{service.tagline}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>

  {
    siblings.length > 0 && (
      <Section index="07" tone="muted" eyebrow={category?.name ?? 'Related'} title="More in this group.">
        <ul class="tech-siblings">
          {siblings.map((item) => (
            <li>
              <a href={withBase(`/about/technologies/${item.slug}`)}>{item.name}</a>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <CtaBand title={`Use ${tech.name} on a Codeaxes engagement.`} primary={site.cta.primary} />
</BaseLayout>

<style>
  .tech-copy {
    display: grid;
    gap: 1rem;
    max-width: 46rem;
  }

  .tech-copy p {
    margin: 0;
    color: var(--mist);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .tech-cases,
  .tech-apps,
  .tech-services,
  .tech-siblings,
  .tech-chips,
  .tech-split ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tech-cases {
    display: grid;
    gap: 0.7rem;
  }

  .tech-cases li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.8rem;
    align-items: start;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: #ffffff;
    padding: 0.95rem 1rem;
    color: var(--paper);
    line-height: 1.5;
  }

  .tech-cases span {
    color: #2f62a8;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .tech-split {
    display: grid;
    gap: 1rem;
  }

  .tech-split article {
    border: 1px solid var(--line);
    border-radius: 1.15rem;
    background: #ffffff;
    padding: 1.15rem 1.2rem 1.25rem;
  }

  .tech-split h3 {
    margin: 0 0 0.8rem;
    color: var(--paper);
    font-size: 1.15rem;
    font-weight: 650;
    letter-spacing: -0.03em;
  }

  .tech-split li {
    position: relative;
    padding: 0.45rem 0 0.45rem 0.9rem;
    color: var(--mist);
    line-height: 1.5;
  }

  .tech-split li::before {
    content: '';
    position: absolute;
    top: 0.85rem;
    left: 0;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: #2f62a8;
  }

  .tech-split article:last-child li::before {
    background: #3d944c;
  }

  .tech-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-chips a,
  .tech-chips span {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    border-radius: 999px;
    background: #e7f1fb;
    padding: 0.35rem 0.95rem;
    color: #16386e;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .tech-chips a:hover {
    background: #2f62a8;
    color: #ffffff;
  }

  .tech-apps {
    display: grid;
    gap: 0.65rem;
  }

  .tech-apps li {
    border-radius: 0.9rem;
    background: #f4f8fc;
    padding: 0.9rem 1rem;
    color: var(--paper);
    line-height: 1.5;
  }

  .tech-services {
    display: grid;
    gap: 0.7rem;
  }

  .tech-services a {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: #ffffff;
    padding: 1rem 1.05rem;
  }

  .tech-services a:hover {
    border-color: #2f62a8;
  }

  .tech-services strong {
    color: var(--paper);
    font-size: 1.05rem;
  }

  .tech-services span {
    color: var(--mist);
    line-height: 1.45;
  }

  .tech-siblings {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tech-siblings a {
    display: inline-flex;
    align-items: center;
    min-height: 2.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: #ffffff;
    padding: 0.35rem 0.95rem;
    color: var(--paper);
    font-weight: 600;
  }

  .tech-siblings a:hover {
    border-color: #2f62a8;
    color: #2f62a8;
  }

  @media (min-width: 800px) {
    .tech-cases,
    .tech-apps,
    .tech-services {
      grid-template-columns: 1fr 1fr;
    }

    .tech-split {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
