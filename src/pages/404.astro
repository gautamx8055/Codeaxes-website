---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout
  title="Page not found"
  description="The page you requested is not on the Codeaxes site."
  path="/404"
>
  <PageHero
    eyebrow="404"
    title="This page is not on the grid."
    body="The URL may be old, mistyped, or the page has moved. Head home or scan the services list."
    layout="rail"
  >
    <Button slot="actions" href="/">Home</Button>
    <Button slot="actions" href="/services" variant="secondary">Services</Button>
  </PageHero>
</BaseLayout>
