---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Section from '../components/ui/Section.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import ServiceCard from '../components/ui/ServiceCard.astro';
import CaseStudyCard from '../components/ui/CaseStudyCard.astro';
import LogoStrip from '../components/ui/LogoStrip.astro';
import ProcessTimeline from '../components/ui/ProcessTimeline.astro';
import TestimonialSlider from '../components/ui/TestimonialSlider.astro';
import AxesMesh from '../components/visuals/AxesMesh.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import { clients } from '../data/clients';
import { featuredCaseStudies } from '../data/case-studies';
import { testimonials } from '../data/testimonials';
import { whyCodeaxes } from '../data/why';
import { techCategories } from '../data/technologies';
---

<BaseLayout
  title={site.name}
  description="Codeaxes designs and engineers scalable web, mobile, AI, and cloud products for ambitious teams."
  path="/"
>
  <section class="relative overflow-hidden border-b border-line">
    <div class="mx-auto grid max-w-6xl gap-12 px-5 py-20 md:px-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] lg:items-center lg:py-28">
      <div>
        <p class="mb-4 flex items-center gap-3 text-sm font-medium tracking-[0.08em] text-axis">
          {site.tagline}
        </p>
        <h1 class="headline-beam font-display text-5xl leading-[1.12] md:text-7xl">
          Build what the next decade runs on.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-mist">
          Codeaxes designs and engineers scalable web, mobile, AI, and cloud products. These are platforms that operators can run, auditors can trust, and teams can extend.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href={site.cta.primary.href}>{site.cta.primary.label}</Button>
          <Button href={site.cta.secondary.href} variant="secondary">{site.cta.secondary.label}</Button>
        </div>
        <div class="mt-8 flex flex-wrap gap-2">
          <span class="status-chip"><span class="live-dot" aria-hidden="true"></span> Axis ready</span>
          {['ai-automation', 'blockchain', 'cloud-computing', 'devops'].map((slug) => {
            const service = services.find((item) => item.slug === slug);
            return service ? <span class="status-chip">{service.shortName}</span> : null;
          })}
        </div>
      </div>
      <div class="tech-frame" data-parallax="0.18">
        <AxesMesh caption="live product mesh · strategy × delivery" />
      </div>
    </div>
  </section>

  <LogoStrip clients={clients} />

  <Section id="services" eyebrow="Services" title="Thirteen practices. One delivery axis." kicker="Each service is a dedicated landing page. Start with the problem you actually have.">
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
      {services.map((service, index) => <ServiceCard service={service} index={String(index + 1).padStart(2, '0')} />)}
    </div>
  </Section>

  <Section id="why" eyebrow="Why Codeaxes" title="The unglamorous work that makes software last." class="border-y border-white/10">
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
      {
        whyCodeaxes.map((item) => (
          <article class="border border-line p-6">
            <h3 class="font-display text-xl text-paper">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-mist">{item.body}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <Section id="work" eyebrow="Case studies" title="Featured product work." kicker="Illustrative engagements used to show how we structure delivery. Outcomes describe the operating change the work targeted.">
    <div class="grid gap-6">
      {featuredCaseStudies.map((study) => <CaseStudyCard study={study} />)}
    </div>
    <div class="mt-8">
      <Button href="/about/case-studies" variant="secondary">All case studies</Button>
    </div>
  </Section>

  <Section id="process" eyebrow="Delivery" title="Discover through scale." kicker="A real sequence. We do not skip Test to make a launch date look pretty.">
    <ProcessTimeline />
  </Section>

  <Section id="stack" eyebrow="Technology" title="An ecosystem we can actually operate." class="border-y border-line">
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
      {
        techCategories.map((category) => (
          <a href={`/about/technologies#${category.id}`} class="border border-line p-5 hover:border-axis">
            <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-pulse">{category.id}</p>
            <h3 class="font-display mt-2 text-2xl text-paper">{category.name}</h3>
            <p class="mt-2 text-sm text-mist">{category.summary}</p>
          </a>
        ))
      }
    </div>
    <div class="mt-8">
      <Button href="/about/technologies" variant="secondary">Open the stack</Button>
    </div>
  </Section>

  <Section id="voices" eyebrow="Testimonials" title="How teams describe the work.">
    <TestimonialSlider items={testimonials} />
  </Section>

  <CtaBand
    eyebrow="Start"
    title="If the problem is real, we can make the first increment concrete."
    body="Share the constraint. We’ll come back with a discovery plan, not a generic deck."
    primary={site.cta.primary}
    secondary={{ label: 'Contact details', href: '/contact' }}
  />
</BaseLayout>
