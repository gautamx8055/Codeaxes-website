---
import { site } from '../data/site';
import { serviceGroups } from '../data/services';
import { technologyCatalogue } from '../data/catalogue';
import { clients } from '../data/clients';
import { caseStudies } from '../data/case-studies';
import { testimonials } from '../data/testimonials';
import { whyCodeaxes } from '../data/why';
import { findTechnology } from '../data/technologies';
import { withBase } from '../lib/seo';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Section from '../components/ui/Section.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import CoverDeck from '../components/ui/CoverDeck.astro';
import CoverFace from '../components/ui/CoverFace.astro';
import LogoStrip from '../components/ui/LogoStrip.astro';
import ProcessTimeline from '../components/ui/ProcessTimeline.astro';
import CaseStudyCard from '../components/ui/CaseStudyCard.astro';
import ComplianceBand from '../components/ui/ComplianceBand.astro';
import TestimonialSlider from '../components/ui/TestimonialSlider.astro';
import ServiceVisual from '../components/visuals/ServiceVisual.astro';
---

<BaseLayout
  title={site.name}
  description="Codeaxes connects AI, product engineering, enterprise solutions, experience design, digital engineering, and advanced engineering across 18 industries."
  path="/"
>
  <section class="mission-hero" data-hero>
    <div class="hero-enter relative mx-auto flex min-h-[calc(100svh-6rem)] max-w-5xl flex-col items-center justify-center px-4 py-16 text-center sm:px-5 md:px-8">
      <p class="kicker mb-6">{site.tagline}</p>
      <h1 class="headline-beam font-display text-[2.85rem] font-medium leading-[1.25] tracking-[-0.05em] sm:text-6xl md:text-7xl lg:text-[5.5rem]">
        Build what the next decade runs on.
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-mist sm:text-lg">
        Codeaxes connects AI, product engineering, enterprise solutions, and advanced engineering to build the products, platforms, and intelligent systems your business runs on.
      </p>
      <div class="mt-8 flex w-full flex-col items-stretch gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:justify-center">
        <Button href={site.cta.primary.href} class="w-full sm:w-auto">{site.cta.primary.label}</Button>
        <Button href={site.cta.secondary.href} variant="secondary" class="w-full sm:w-auto">{site.cta.secondary.label}</Button>
      </div>
    </div>
  </section>

  <LogoStrip clients={clients} />

  <Section id="services" index="01" eyebrow="Services" title="Six disciplines. One engineering partner." kicker="From AI and enterprise platforms to connected products and autonomous systems. Explore the capabilities behind your next move." split>
    <CoverDeck label="Services" emphasis>
      {
        serviceGroups.map((group) => (
          <a href={withBase(`/services#${group.id}`)} data-cover-card data-cover-id={group.id}>
            <CoverFace kicker={`${group.services.length} services`} title={group.name} body={group.summary}>
              <ServiceVisual kind={group.visual} />
            </CoverFace>
          </a>
        ))
      }
    </CoverDeck>
  </Section>

  <Section id="why" index="02" tone="muted" eyebrow="Why Codeaxes" title="The unglamorous work that makes software last.">
    <div class="grid gap-0 border-t border-line md:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
      {
        whyCodeaxes.map((item, index) => (
          <article class="border-b border-line p-6 md:border-r">
            <p class="kicker mb-4">{String(index + 1).padStart(2, '0')}</p>
            <h3 class="font-display text-2xl text-paper">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-mist">{item.body}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <Section id="work" index="03" tone="ink" eyebrow="Case studies" title="Featured product work." kicker="Illustrative engagements used to show how we structure delivery. Outcomes describe the operating change the work targeted." split>
    <div class="grid gap-5 md:grid-cols-2" data-reveal-stagger>
      {caseStudies.slice(0, 4).map((study) => <CaseStudyCard study={study} />)}
    </div>
    <div class="mt-8 text-center">
      <Button href="/about/case-studies" variant="secondary">All case studies</Button>
    </div>
  </Section>

  <ComplianceBand />

  <Section id="process" index="04" tone="muted" eyebrow="Delivery" title="Discover through scale." kicker="A real sequence. We do not skip Test to make a launch date look pretty." split>
    <ProcessTimeline />
  </Section>

  <Section id="stack" index="05" tone="ink" eyebrow="Technology" title="An ecosystem we can actually operate." kicker="A connected technology ecosystem across 24 categories. Explore a few of the foundations, or browse the complete catalogue." split>
    <div class="tech-groups">
      {
        technologyCatalogue.filter((category) => ['frontend-web-technologies', 'generative-ai-llm-agentic-ai', 'data-engineering-analytics', 'cloud-computing-infrastructure', 'embedded-systems-firmware-engineering', 'digital-twins-simulation-spatial-computing'].includes(category.id)).map((category) => (
          <article class="tech-group">
            <header>
              <h3>
                <a href={withBase(`/about/technologies#${category.id}`)}>{category.name}</a>
              </h3>
            </header>
            <ul>
              {category.sections.flatMap((section) => section.items).slice(0, 4).map((name) => {
                const tech = findTechnology(name);
                return <li><a href={withBase(tech ? `/about/technologies/${tech.slug}` : `/about/technologies#${category.id}`)}><strong>{name}</strong></a></li>;
              })}
            </ul>
          </article>
        ))
      }
    </div>
    <div class="mt-8 text-center">
      <Button href="/about/technologies" variant="secondary">All technologies</Button>
    </div>
  </Section>

  <div class="home-close">
    <Section id="voices" index="06" padBottom="tight" eyebrow="Testimonials" title="How teams describe the work.">
      <TestimonialSlider items={testimonials} />
      <div class="mt-8 text-center">
        <Button href="/about/testimonials" variant="secondary">All testimonials</Button>
      </div>
    </Section>

    <CtaBand
      blend
      eyebrow="Start"
      title="If the problem is real, we can make the first increment concrete."
      body="Share the constraint. We’ll come back with a discovery plan, not a generic deck."
      primary={site.cta.primary}
      secondary={{ label: 'Contact details', href: '/contact' }}
    />
  </div>
</BaseLayout>

<style>
  .tech-groups {
    display: grid;
    gap: 1rem;
  }

  .tech-group {
    border: 1px solid var(--line);
    border-radius: 1.25rem;
    background: #ffffff;
    padding: 1.15rem;
  }

  .tech-group header {
    display: grid;
    gap: 0.35rem;
    margin-bottom: 0.9rem;
  }

  .tech-group h3 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 650;
    letter-spacing: -0.03em;
    line-height: 1.25;
  }

  .tech-group h3 a {
    color: var(--paper);
  }

  .tech-group h3 a:hover {
    color: var(--axis);
  }

  .tech-group header p {
    margin: 0;
    max-width: 42rem;
    color: var(--mist);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .tech-group ul {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tech-group li a {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    gap: 0.3rem;
    border-radius: 0.9rem;
    background: #f4f8fc;
    padding: 0.85rem 0.95rem;
  }

  .tech-group li a:hover {
    background: #e7f1fb;
  }

  .tech-group strong {
    color: var(--paper);
    font-size: 0.98rem;
    font-weight: 650;
  }

  .tech-group li span {
    display: -webkit-box;
    overflow: hidden;
    color: var(--mist);
    font-size: 0.86rem;
    line-height: 1.45;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  @media (min-width: 720px) {
    .tech-group {
      padding: 1.35rem;
    }

    .tech-group ul {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1100px) {
    .tech-group ul {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }
</style>
