---
import BrandHeader from '../../components/chrome/BrandHeader.astro';
import type { HeaderNavItem, HeaderSearchEntry } from '../../components/chrome/header-types';
import { site } from '../content/site';
import { services } from '../content/services';
import { codeaxesPath, kx } from '../lib/paths';
import Mark from './Mark.astro';

const disciplines = [
  { id: 'growth', label: 'Growth & strategy', description: 'Search, social, and performance working toward the same commercial outcome.', slugs: ['seo', 'smm', 'performance-marketing'] },
  { id: 'creative', label: 'Creative & content', description: 'Identity, graphics, and film that share one brand language.', slugs: ['graphics', 'video-production'] },
  { id: 'experiences', label: 'Immersive experiences', description: 'AR and VR experiences that bring your brand into a new dimension.', slugs: ['ar-vr'] },
];
const nav: HeaderNavItem[] = [
  {
    id: 'services', label: 'Services', href: kx('/services'),
    groups: disciplines.map((group) => ({
      id: group.id, label: group.label, description: group.description, href: kx('/services'),
      links: services.filter((service) => group.slugs.includes(service.slug)).map((service) => ({ label: service.title === 'Search' ? 'Search Engine Optimisation' : service.title === 'Social' ? 'Social Media Marketing' : service.title === 'Performance' ? 'Performance Marketing' : service.title === 'Film' ? 'Video Production' : service.title, href: service.href })),
    })),
  },
  { id: 'work', label: 'Work', href: kx('/#work') },
  { id: 'about', label: 'About', href: kx('/about') },
  { id: 'careers', label: 'Careers', href: codeaxesPath('/careers') },
];
const searchEntries: HeaderSearchEntry[] = [
  ...nav.map((item) => ({ label: item.label, href: item.href, category: 'Explore Kuroaxe' })),
  { label: 'Contact Kuroaxe', href: kx('/contact'), category: 'Start a conversation' },
  { label: 'Codeaxes', href: site.codeaxes.url, category: 'Technology & engineering' },
  ...services.map((service) => ({ label: service.shortTitle, href: service.href, category: 'Services', keywords: `${service.title} ${service.description}` })),
  ...nav.flatMap((item) => item.groups?.flatMap((group) => group.links.map((link) => ({ ...link, category: group.label }))) ?? []),
];
---

<BrandHeader brand="kuroaxe" name="Kuroaxe" nav={nav} contactHref={kx('/contact')} partner={{ name: 'Codeaxes', href: site.codeaxes.url }} searchEntries={searchEntries} searchPlaceholder="Search services, creative, growth…">
  <a slot="logo" href={kx('/')} aria-label="Kuroaxe home"><Mark /><span data-brand-name>Kuroaxe</span></a>
  <img slot="partner-mark" src={codeaxesPath('/favicon.svg')} alt="" width="32" height="32" />
</BrandHeader>
