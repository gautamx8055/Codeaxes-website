# Codeaxes website environment

# Optional LLM for Codeaxes AI. Leave unset to use local site search.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Hiring workspace: required to create, update, or delete job postings.
JOBS_API_KEY=
# Optional. Comma-separated origins allowed to call /api/jobs from a browser (CORS).
JOBS_APP_ORIGIN=
# Optional. Absolute or cwd-relative path for the jobs JSON store.
JOBS_DATA_PATH=
